{
  "name": "firstapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:status": "prisma migrate status",
    "owner:set": "node scripts/set-owner.mjs",
    "zatca:gateway": "dotnet run --project zatca-gateway",
    "zatca:selftest": "dotnet run --project zatca-gateway -- --selftest",
    "zatca:publish": "dotnet publish zatca-gateway/ZatcaGateway.csproj -c Release -o zatca-gateway/publish"
  },
  "dependencies": {
