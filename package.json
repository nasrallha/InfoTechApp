    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "html2canvas-pro": "^1.5.11",
    "jsbarcode": "^3.11.6",
    "jspdf": "^3.0.1",
    "mariadb": "^3.4.0",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
