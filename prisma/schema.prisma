// ============================================================
// إعدادات Prisma
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// رابط قاعدة البيانات موجود في prisma.config.ts (من DATABASE_URL في .env)
datasource db {
  provider = "mysql"
}

// ملاحظات عامة:
// - اسم الموديل مفرد (Product)، واسم الجدول في MySQL جمع بحروف صغيرة (products) عن طريق @@map
// - كل الأسماء بالعربي والإنجليزي (arName / enName)
// - الحقول الاختيارية الفريدة (phone, taxNo, ...) تُحفظ null وليس نصاً فاضياً

// ============================================================
// الأدوار (Role)
// ============================================================

model Role {
  id       Int     @id @default(autoincrement())
  arName   String  @unique @db.VarChar(50)
  enName   String  @unique @db.VarChar(50)
  isActive Boolean @default(true)

  // مدير النظام: له كل الصلاحيات وكل الفروع (لا يحتاج صفوف في role_permissions)
  isSuper Boolean @default(false)
  // دور مالك البرنامج (مخفي: مش بيظهر في شاشة الأدوار ولا في الاختيار)
  isOwner Boolean @default(false)
  // دور ثابت من لوحة التحكم (قالب): مقفول، العميل يختاره للمستخدمين بس
  // (القيمة = رقم القالب في اللوحة، null = دور عادي)
  templateKey String? @unique @db.VarChar(40)
  // الدور الثابت اتعدّل للشركة دي (مالك البرنامج غيّر اسمه أو صلاحياته):
  // اللوحة متكتبش فوقه وهي بتطبّق القوالب (إلا لو اخترت «طبّق على الكل» أو «رجّع للقالب»)
  isCustomized Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// ============================================================
// الفروع (Branch)
// ============================================================

model Branch {
  id       Int     @id @default(autoincrement())
  arName   String  @unique @db.VarChar(100)
  enName   String  @unique @db.VarChar(100)
  address  String  @db.VarChar(255)
  isActive Boolean @default(true)

  // بيانات الفرع في الفاتورة (لو فاضية تُؤخذ من بيانات الشركة)
  phone          String? @db.VarChar(20)
  // معرّف الفرع في الفاتورة: النوع (CRN سجل تجاري | 700 الرقم الموحد | MOM | MLS | SAG | OTH)
  // + الرقم في registrationNo (فاضي = معرّف الشركة)
  idScheme       String? @db.VarChar(3)
  registrationNo String? @db.VarChar(30) // رقم المعرّف (السجل التجاري الفرعي...)
  city           String? @db.VarChar(100)
  district       String? @db.VarChar(100)
  street         String? @db.VarChar(100)
  buildingNo     String? @db.VarChar(4)
  additionalNo   String? @db.VarChar(4)
  postalCode     String? @db.VarChar(5)

  // مستودع الفرع: مشترياته تدخله ومبيعاته تخرج منه
  // (أكثر من فرع على نفس المستودع = مخزون مشترك)
  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // قائمة أسعار الفرع (لو الصنف ليس له سعر فيها: السعر الأساسي)
  priceListId Int?
  priceList   PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)

  users    User[]
  sessions Session[] // الجلسات المفتوحة حالياً على هذا الفرع
  purchases Purchase[] // فواتير المشتريات ومرتجعاتها المسجلة على الفرع
  sales      Sale[]
  quotations Quotation[]
  shifts     Shift[]
  // طلبات الضمان والصيانة المستلمة في الفرع
  warrantyClaims WarrantyClaim[]
  maintenanceContracts MaintenanceContract[]
  followUps            FollowUp[]
  bookings             Booking[]
  vouchers      Voucher[]
  cashMovements CashMovement[]

  promotions PromotionBranch[]
  zatcaUnit  ZatcaUnit? // وحدة الربط مع الزكاة (EGS) للفرع

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // المغسلة (وحدة laundry): طلبات الاستلام
  laundryOrders LaundryOrder[]
  // المطعم: طابعات الفرع (الكاشير والتحضير)
  restaurantPrinters RestaurantPrinter[]
  restaurantTables   RestaurantTable[]
  // وسيط الطباعة: كود الربط + الأجهزة المربوطة + مهام الطباعة
  printAgentKey      String?            @unique @db.VarChar(20)
  printAgents        PrintAgent[]
  printJobs          PrintJob[]
  // المغسلة (وحدة laundry): الاشتراكات
  laundryWallets LaundryWallet[]
  @@index([warehouseId])
  @@index([priceListId])
  @@map("branches")
}

// ============================================================
// المستخدمون (User)
// ============================================================

model User {
  id         Int     @id @default(autoincrement())
  username   String  @unique @db.VarChar(50)
  arFullname String  @db.VarChar(100)
  enFullname String  @db.VarChar(100)
  password   String  @db.VarChar(255) // تُحفظ مشفّرة (hash) وليس النص الأصلي
  image      String? @db.VarChar(255)
  isActive   Boolean @default(true)
  // مالك البرنامج: بيدخل بالحساب اللي في ملف الإعدادات (.env)، والصف ده مخفي
  // (عشان الفواتير والمستندات اللي بيعملها تتسجل باسمه)
  isOwner    Boolean @default(false)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // الفرع الأساسي: المستخدم يدخل عليه تلقائياً بعد تسجيل الدخول
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  lastLoginAt DateTime?

  sessions Session[]
  loginAttempts LoginAttempt[]
  purchases Purchase[] // فواتير المشتريات التي سجلها
  transfersCreated  StockTransfer[]  @relation("TransferCreatedBy")
  adjustmentsCreated StockAdjustment[] @relation("AdjustmentCreatedBy")
  transfersReceived StockTransfer[]  @relation("TransferReceivedBy")
  countsCreated     InventoryCount[] @relation("CountCreatedBy")
  countsPosted      InventoryCount[] @relation("CountPostedBy")
  sales             Sale[]
  quotations        Quotation[]
  warrantyClaims    WarrantyClaim[]
  claimLogs         WarrantyClaimLog[]
  maintenanceContracts MaintenanceContract[]
  followUpsCreated     FollowUp[]    @relation("FollowUpCreatedBy")
  bookingsCreated      Booking[]     @relation("BookingCreatedBy")
  followUpLogs         FollowUpLog[] @relation("FollowUpLogUser")
  shifts            Shift[]          @relation("ShiftCashier")
  shiftsClosed      Shift[]          @relation("ShiftClosedBy")
  vouchers          Voucher[]
  cashMovements     CashMovement[]

  promotions        Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // المغسلة (وحدة laundry): طلبات الاستلام
  laundryOrdersCreated   LaundryOrder[] @relation("LaundryOrderCreatedBy")
  laundryOrdersDelivered LaundryOrder[] @relation("LaundryOrderDeliveredBy")
  // المغسلة (وحدة laundry): الاشتراكات
  laundryWalletsCreated LaundryWallet[] @relation("LaundryWalletCreatedBy")
  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

// ============================================================
// صلاحيات الأدوار (RolePermission)
// - كل صف = دور + صلاحية واحدة، مثال: (2, "products.create")
// - قائمة الصلاحيات الموجودة في النظام مكتوبة في الكود: lib/permissions.js
// ============================================================

model RolePermission {
  id Int @id @default(autoincrement())

  // حذف الدور يحذف صلاحياته معه
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission String @db.VarChar(100)

  @@unique([roleId, permission]) // نفس الصلاحية لا تتكرر لنفس الدور
  @@index([roleId])
  @@map("role_permissions")
}

// ============================================================
// الجلسات (Session) - كل تسجيل دخول من جهاز = جلسة
// - الـ cookie فيها رقم عشوائي، ونحفظ هنا الـ hash بتاعه فقط (لو تسربت قاعدة البيانات لا تُستخدم)
// - branchId = الفرع الحالي الذي يعمل عليه المستخدم في هذه الجلسة
// ============================================================

model Session {
  id        Int    @id @default(autoincrement())
  tokenHash String @unique @db.VarChar(64)

  // حذف المستخدم يحذف جلساته
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  userAgent String?  @db.VarChar(255)
  ip        String?  @db.VarChar(45) // عنوان الجهاز وقت الدخول
  expiresAt DateTime
  // آخر نشاط (للخروج بعد عدم النشاط + شاشة الأجهزة)
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([branchId])
  @@map("sessions")
}

// ============================================================
// أمان الدخول: الإعدادات (صف واحد id = 1) + سجل المحاولات + القفل المؤقت
// ============================================================

model SecuritySettings {
  id Int @id

  // القفل بعد محاولات غلط (0 = بدون قفل)
  maxAttempts          Int     @default(5)
  attemptWindowMinutes Int     @default(15) // المحاولات بتتعد خلال المدة دي
  lockMinutes          Int     @default(10)
  progressiveLock      Boolean @default(true) // القفل يطول لو كرر الغلط
  showRemaining        Boolean @default(true) // يظهر عدد المحاولات المتبقية
  // القفل على الجهاز (IP) بعد محاولات غلط من أي أسماء (0 = بدون)
  ipMaxAttempts        Int     @default(0)

  // الجلسة
  idleMinutes          Int     @default(0) // خروج بعد عدم نشاط (0 = بدون)
  sessionHours         Int     @default(168) // أقصى مدة للجلسة
  logoutOnBrowserClose Boolean @default(false)

  // عدد الأجهزة للمستخدم في نفس الوقت (0 = بدون حد)
  maxDevices        Int     @default(0)
  deviceLimitMode   String  @default("oldest") @db.VarChar(10) // oldest | reject
  deviceLimitSkipSuper Boolean @default(true) // مدير النظام مستثنى

  logRetentionDays Int @default(90) // مدة الاحتفاظ بسجل الدخول

  updatedAt DateTime @updatedAt

  @@map("security_settings")
}

model LoginAttempt {
  id       Int    @id @default(autoincrement())
  username String @db.VarChar(50) // زي ما اتكتب (حتى لو المستخدم مش موجود)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  success   Boolean
  // ok | invalid | locked | ipLocked | disabled | branchInactive | deviceLimit
  reason    String  @db.VarChar(20)
  ip        String? @db.VarChar(45)
  userAgent String? @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([username, createdAt])
  @@index([userId])
  @@map("login_attempts")
}

model LoginLock {
  id   Int    @id @default(autoincrement())
  kind String @db.VarChar(4) // user | ip
  key  String @db.VarChar(64) // اسم المستخدم (حروف صغيرة) أو الـ IP

  failures    Int       @default(0)
  windowStart DateTime
  lastFailAt  DateTime
  lockedUntil DateTime?
  lockCount   Int       @default(0) // عدد مرات القفل (للقفل المتزايد)

  updatedAt DateTime @updatedAt

  @@unique([kind, key])
  @@index([lockedUntil])
  @@map("login_locks")
}

// ============================================================
// الأقسام (Category) - شجرة من مستويين: رئيسي ← فرعي
// ============================================================

model Category {
  id       Int     @id @default(autoincrement())
  arName   String  @unique @db.VarChar(100)
  enName   String  @unique @db.VarChar(100)
  image    String? @db.VarChar(255)
  isActive Boolean @default(true)

  // القسم الأب: فاضي (null) = قسم رئيسي، فيه رقم = قسم فرعي
  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  products Product[]
  // المطعم: طابعات التحضير اللي بتطبع القسم ده
  restaurantPrinters RestaurantPrinterCategory[]
  // عمولة مقدم الخدمة على القسم ده
  technicianRates TechnicianRate[]

  promotions PromotionCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

// ============================================================
// الوحدات (Unit) - قطعة، علبة، كرتونة ...
// ============================================================

model Unit {
  id       Int     @id @default(autoincrement())
  arName   String  @unique @db.VarChar(100)
  enName   String  @unique @db.VarChar(100)
  isActive Boolean @default(true)
  // تقبل كسور (كيلو 0.250) ولا لأ (حبة): البيع والشراء والمخزون بيتأكدوا منها
  allowDecimals Boolean @default(true)

  products     Product[] // المنتجات التي هذه الوحدة هي وحدتها الأساسية
  productUnits ProductUnit[] // استخدام الوحدة كوحدة إضافية لمنتج
  purchaseItems PurchaseItem[] // استخدام الوحدة في فواتير المشتريات
  saleItems      SaleItem[]
  quotationItems QuotationItem[]
  transferItems StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  prices        ProductPrice[]
  claimItems    WarrantyClaimItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

// ============================================================
// المنتجات (Product)
// - الأسعار والتكلفة هنا للوحدة الأساسية
// - code = باركود الوحدة الأساسية
// ============================================================

model Product {
  id     Int     @id @default(autoincrement())
  code   String  @unique @db.VarChar(50)
  arName String  @db.VarChar(150)
  enName String  @db.VarChar(150)
  image  String? @db.VarChar(255)

  // الأسعار (للوحدة الأساسية)
  cost           Decimal @default(0) @db.Decimal(18, 4)
  price          Decimal @default(0) @db.Decimal(18, 4)
  wholesalePrice Decimal @default(0) @db.Decimal(18, 4)

  // الضريبة
  taxRate           Decimal @default(0) @db.Decimal(5, 2) // نسبة مئوية، مثال: 15.00
  isPriceIncludeTax Boolean @default(false)
  // فئة الضريبة للفوترة الإلكترونية: S خاضع | Z صفري | E معفى | O خارج النطاق
  // (النسبة > 0 = S دائماً، والنسبة 0 لازم لها فئة وسبب إعفاء VATEX)
  taxCategory        String  @default("S") @db.VarChar(1)
  taxExemptionCode   String? @db.VarChar(20)
  taxExemptionReason String? @db.VarChar(255)

  // الرصيد الافتتاحي بالوحدة الأساسية (كسور: الأصناف الموزونة 1.250 كجم)
  startStock Decimal @default(0) @db.Decimal(18, 3)

  isActive Boolean @default(true)

  // المستودعات اللي الصنف متاح فيها (الفروع بتشوف أصناف مستودعها بس):
  // true = كل المستودعات | false = المستودعات المسجلة في product_warehouses بس
  // (المستودع الرئيسي فيه كل الأصناف دايماً)
  allWarehouses Boolean @default(true)
  warehouses    ProductWarehouse[]

  // خدمة (مصنعية، تركيب...): بتتباع عادي ومالهاش مخزون ولا حركات
  isService Boolean @default(false)

  // المتابعة الدورية (وحدة followUps): 0 = الصنف مالوش متابعة
  // غير كده = المدة المقترحة بالأيام (بتتغير لكل عميل في الفاتورة)
  followUpDays Int @default(0)

  // التغيير الدوري للسيارات (وحدة vehicles): زيت، فلتر...
  // الغيار الجاي = العداد + changeKm، أو تاريخ الفاتورة + changeMonths (أيهما أقرب)
  changeKm     Int @default(0)
  changeMonths Int @default(0)

  // مدة الخدمة بالدقايق (الحجوزات): 0 = من غير مدة
  durationMin Int @default(0)

  // الأرقام التسلسلية (وحدة serials): 0 لا يتتبع | 1 رقم واحد | 2 رقمين
  // الاسم اختياري (IMEI 1 / الوحدة الداخلية...)، فاضي = "الرقم التسلسلي"
  serialCount  Int     @default(0)
  serialLabel1 String? @db.VarChar(40)
  serialLabel2 String? @db.VarChar(40)
  // الضمان الافتراضي في الفاتورة: بالشهور (0 = بدون) + الجهة: agent الوكيل | store المحل
  warrantyMonths Int     @default(0)
  warrantyType   String? @db.VarChar(10)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  baseUnitId Int
  baseUnit   Unit @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)

  // الوحدات الإضافية (علبة، كرتونة ...)
  productUnits ProductUnit[]

  // أصناف فواتير المشتريات (لا يُحذف منتج عليه فواتير)
  purchaseItems PurchaseItem[]

  // أصناف فواتير المبيعات وعروض الأسعار
  saleItems      SaleItem[]
  quotationItems QuotationItem[]

  // المخزون والتحويلات والجرد وقوائم الأسعار
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  transferItems  StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  countItems     InventoryCountItem[]
  prices         ProductPrice[]

  promotions PromotionProduct[]

  // الأرقام التسلسلية لقطع الصنف
  serials ProductSerial[]
  // طلبات الضمان على الصنف + قطع الغيار والمصنعية في الطلبات
  warrantyClaims WarrantyClaim[]
  claimItems     WarrantyClaimItem[]
  maintenanceContracts MaintenanceContract[]
  followUps            FollowUp[]
  // عمولة مقدم الخدمة على الصنف ده بالذات
  technicianRates      TechnicianRate[]
  bookingItems         BookingItem[]
  // المغسلة (وحدة laundry): الصنف قطعة مغسلة وأسعار خدماتها
  laundryItem          LaundryItem?
  // المطعم (وحدة restaurant): الصنف في المنيو (أحجامه وإضافاته)
  restaurantItem       RestaurantItem?
  // المطعم: طابعة تحضير خاصة بالصنف (غير طابعة قسمه)
  restaurantPrinters   RestaurantPrinterProduct[]

  // المقاسات والألوان (وحدة variants): الصنف مقاس (ولون) من موديل
  // الاسم فيه المقاس («حذاء X - 42») عشان يظهر في البحث والفواتير والطباعة
  modelId Int?
  model   ProductModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  size    String?       @db.VarChar(30)
  color   String?       @db.VarChar(30)
  // لون الدايرة (#RRGGBB) في الكاشير وشاشة المقاسات
  colorHex String?      @db.VarChar(9)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // المغسلة (وحدة laundry): طلبات الاستلام
  laundryOrderItems LaundryOrderItem[]
  @@index([categoryId])
  @@index([baseUnitId])
  @@index([modelId])
  @@map("products")
}

// ============================================================
// الموديل (وحدة variants): اسم مشترك لمقاسات الصنف (وألوانه)
// code = كود الصنف الأصلي (أكواد المقاسات: الكود-المقاس)
// ============================================================
model ProductModel {
  id     Int    @id @default(autoincrement())
  arName String @db.VarChar(150)
  enName String @db.VarChar(150)
  code   String @db.VarChar(50)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_models")
}

// ألوان المقاسات اللي التاجر ضافها بنفسه (اللوحة الجاهزة في lib/variant-colors.js)
model VariantColor {
  id     Int    @id @default(autoincrement())
  arName String @unique @db.VarChar(30)
  hex    String @db.VarChar(9)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("variant_colors")
}

// ============================================================
// الوحدات الإضافية للمنتج (ProductUnit)
// - الوحدة الأساسية لا تُسجل هنا، هي baseUnit في Product
// - conversionFactor = كم وحدة أساسية داخل هذه الوحدة (كرتونة = 50 قطعة)
// ============================================================

model ProductUnit {
  id Int @id @default(autoincrement())

  // حذف المنتج يحذف وحداته الإضافية معه
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  conversionFactor Decimal @default(1) @db.Decimal(18, 4)
  barcode          String? @unique @db.VarChar(50)

  // الرصيد الافتتاحي بهذه الوحدة (10 كرتونة)، يُضاف لرصيد الصنف الافتتاحي
  startStock Decimal @default(0) @db.Decimal(18, 3)

  // أسعار هذه الوحدة
  cost  Decimal @default(0) @db.Decimal(18, 4)
  price Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, unitId]) // نفس الوحدة لا تتكرر لنفس المنتج
  @@index([productId])
  @@index([unitId])
  @@map("product_units")
}

// ============================================================
// العملاء (Customer)
// ============================================================

model Customer {
  id     Int    @id @default(autoincrement())
  code   Int    @unique
  arName String @db.VarChar(255)
  enName String @db.VarChar(255)

  // اختيارية لكن لا تتكرر
  phone          String? @unique @db.VarChar(11)
  taxNo          String? @unique @db.VarChar(15) // الرقم الضريبي
  registrationNo String? @unique @db.VarChar(10) // قديم: السجل بقى في المعرّف (idScheme = CRN)

  // معرّف العميل للربط مع الزكاة لو مالوش رقم ضريبي (أو العميل الأجنبي)
  // idScheme: CRN سجل | 700 الرقم الموحد | NAT هوية | IQA إقامة | PAS جواز | GCC | TIN | MOM | MLS | SAG | OTH
  idScheme String? @db.VarChar(5)
  idNumber String? @db.VarChar(30)

  // الدولة (كود ISO من حرفين): SA = عميل محلي، غيرها = عميل خارج المملكة (تصدير)
  countryCode String @default("SA") @db.VarChar(2)

  // العنوان (الوطني للعميل المحلي - اختياري بالكامل)
  // المقاسات أوسع شوية عشان عناوين العملاء برّه المملكة
  city         String? @db.VarChar(100)
  district     String? @db.VarChar(100)
  street       String? @db.VarChar(100)
  buildingNo   String? @db.VarChar(10)
  additionalNo String? @db.VarChar(10)
  postalCode   String? @db.VarChar(10)

  // الرصيد الافتتاحي (المنقول من النظام القديم): موجب = عليه لنا
  openingBalance Decimal @default(0) @db.Decimal(18, 4)

  isActive Boolean @default(true)

  sales      Sale[]
  quotations Quotation[]
  vouchers   Voucher[]
  // الأجهزة المشتراة (الأرقام التسلسلية)
  serials    ProductSerial[]
  warrantyClaims WarrantyClaim[]
  maintenanceContracts MaintenanceContract[]
  followUps            FollowUp[]
  vehicles             Vehicle[]
  bookings             Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // المغسلة (وحدة laundry): طلبات الاستلام
  laundryOrders LaundryOrder[]
  // المغسلة (وحدة laundry): الاشتراكات
  laundryWallets LaundryWallet[]
  @@unique([idScheme, idNumber])
  @@map("customers")
}

// ============================================================
// الموردون (Supplier)
// ============================================================

model Supplier {
  id     Int    @id @default(autoincrement())
  code   Int    @unique
  arName String @db.VarChar(255)
  enName String @db.VarChar(255)

  // اختيارية لكن لا تتكرر
  phone          String? @unique @db.VarChar(11)
  taxNo          String? @unique @db.VarChar(15) // الرقم الضريبي
  registrationNo String? @unique @db.VarChar(10) // السجل التجاري

  // العنوان الوطني (اختياري بالكامل)
  city         String? @db.VarChar(100)
  district     String? @db.VarChar(100)
  street       String? @db.VarChar(100)
  buildingNo   String? @db.VarChar(4)
  additionalNo String? @db.VarChar(4)
  postalCode   String? @db.VarChar(5)

  // الرصيد الافتتاحي (المنقول من النظام القديم): موجب = له علينا
  openingBalance Decimal @default(0) @db.Decimal(18, 4)

  isActive Boolean @default(true)

  vouchers Voucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[] // فواتير المشتريات (لا يُحذف مورد عليه فواتير)
  // طلبات الضمان المبعوتة له
  warrantyClaims WarrantyClaim[]

  @@map("suppliers")
}

// ============================================================
// بيانات الشركة (Company) - صف واحد فقط (id = 1)
// تظهر في الفواتير والتقارير: الاسم، الرقم الضريبي، العنوان الوطني، الشعار
// ============================================================

model Company {
  id     Int    @id @default(1)
  arName String @db.VarChar(255)
  enName String @db.VarChar(255)

  taxNo          String? @db.VarChar(15) // الرقم الضريبي
  registrationNo String? @db.VarChar(10) // السجل التجاري
  // معرّف البائع في الفاتورة الإلكترونية (الزكاة)
  // CRN = السجل التجاري (من سجل الفرع أو الشركة) | 700 الرقم الموحد | MOM | MLS | SAG | OTH
  sellerIdScheme String  @default("CRN") @db.VarChar(5)
  sellerIdNumber String? @db.VarChar(30) // للأنواع غير السجل التجاري

  // التواصل (يظهران على الفاتورة)
  phone String? @db.VarChar(20)
  email String? @db.VarChar(100)

  // العنوان الوطني
  city         String? @db.VarChar(100)
  district     String? @db.VarChar(100)
  street       String? @db.VarChar(100)
  buildingNo   String? @db.VarChar(4)
  additionalNo String? @db.VarChar(4)
  postalCode   String? @db.VarChar(5)

  // الحساب البنكي (يظهر على الفاتورة لو مفعّل في إعدادات الطباعة)
  bankName          String? @db.VarChar(100)
  bankAccountName   String? @db.VarChar(150) // اسم صاحب الحساب
  bankAccountNumber String? @db.VarChar(30)
  iban              String? @db.VarChar(34)

  logo String? @db.VarChar(255) // مسار الشعار داخل uploads

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company")
}

// ============================================================
// قوالب ملصقات الباركود (BarcodeLabel)
// - كل قالب = مقاس ملصق (بالمللي) + ما يظهر عليه
// - قالب واحد فقط يكون افتراضياً (isDefault)
// ============================================================

model BarcodeLabel {
  id     Int    @id @default(autoincrement())
  arName String @unique @db.VarChar(100)
  enName String @unique @db.VarChar(100)

  // مقاس الملصق بالمللي
  width  Int
  height Int

  // نوع الباركود: CODE128 (يقبل أي كود) أو EAN13 (13 رقم)
  barcodeFormat String @default("CODE128") @db.VarChar(20)
  // حجم خطوط الباركود داخل الملصق: small / normal / large
  barcodeSize   String @default("normal") @db.VarChar(10)

  // ما يظهر على الملصق
  showName     Boolean @default(true)
  showPrice    Boolean @default(true)
  priceWithTax Boolean @default(true) // السعر المطبوع شامل الضريبة؟
  showCode     Boolean @default(true) // رقم الكود تحت الخطوط
  showCompany  Boolean @default(false)

  // أحجام الخط (pt)
  nameFontSize  Int @default(8)
  priceFontSize Int @default(10)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barcode_labels")
}

// ============================================================
// إعدادات طباعة الفواتير (InvoicePrintSettings) - صف واحد فقط (id = 1)
// بيانات الشركة والفرع وQR الزكاة تظهر دائماً (إجبارية)، وهنا الاختيارات فقط
// ============================================================

model InvoicePrintSettings {
  id Int @id @default(1)

  // الورق: A4 / 80mm / 58mm
  paperSize String @default("80mm") @db.VarChar(10)

  // الهوامش بالمللي
  marginTop    Int @default(2)
  marginBottom Int @default(2)
  marginRight  Int @default(2)
  marginLeft   Int @default(2)

  // حجم الخط: small / normal / large
  fontSize String @default("normal") @db.VarChar(10)

  // لغة الفاتورة: ar / en / both
  language String @default("both") @db.VarChar(5)

  // الشعار
  showLogo Boolean @default(true)
  logoSize String  @default("medium") @db.VarChar(10) // small / medium / large

  // رأس الفاتورة
  showCashier  Boolean @default(true)
  showCustomer Boolean @default(true)
  // بيانات التواصل في رأس الفاتورة (بعنوانها: الجوال / البريد)
  showPhone    Boolean @default(true)
  showEmail    Boolean @default(false)

  // أعمدة الأصناف
  showItemCode Boolean @default(false)
  showUnit     Boolean @default(true)
  showDiscount Boolean @default(true)
  showItemTax  Boolean @default(false)

  // ذيل الفاتورة (يظهر قبل/بعد QR الزكاة)
  showBankAccount Boolean @default(false) // الحساب البنكي للشركة

  footerTextAr String? @db.VarChar(500)
  footerTextEn String? @db.VarChar(500)

  // التشغيل
  autoPrint Boolean @default(false) // طباعة تلقائية بعد حفظ الفاتورة
  copies    Int     @default(1) // عدد النسخ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_print_settings")
}

// ============================================================
// العملات (Currency)
// - عملة أساسية واحدة فقط (isBase) يعمل بها النظام كله: الأسعار والمخزون والتقارير
// - باقي العملات محفوظة للمستقبل (الشراء/البيع بعملة أخرى بسعر صرف)
// ============================================================

model Currency {
  id       Int    @id @default(autoincrement())
  code     String @unique @db.VarChar(3) // رمز ISO: SAR, EGP, USD
  arName   String @db.VarChar(50)
  enName   String @db.VarChar(50)
  arSymbol String @db.VarChar(10) // ر.س
  enSymbol String @db.VarChar(10) // SAR
  decimals Int    @default(2) // عدد الخانات العشرية

  isBase   Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currencies")
}

// ============================================================
// طرق الدفع (PaymentMethod)
// type: cash (نقدي) / card (بطاقة) / wallet (محفظة) / transfer (تحويل) / credit (آجل)
// النوع يحدد طريقة التعامل في الفاتورة (درج الكاشير، رقم العملية، دين على العميل)
// ============================================================

model PaymentMethod {
  id     Int    @id @default(autoincrement())
  arName String @unique @db.VarChar(50)
  enName String @unique @db.VarChar(50)
  type   String @db.VarChar(10)

  // يطلب رقم العملية/الحوالة عند الدفع (للمطابقة)
  requiresReference Boolean @default(false)

  sortOrder Int     @default(0) // ترتيب الظهور في الفاتورة
  isActive  Boolean @default(true)

  // طريقة ثابتة من لوحة التحكم (قوالب طرق الدفع): "P<رقم القالب>"
  // في وضع الشركات: الشركة تقدر توقفها وتشغّلها بس
  templateKey String? @unique @db.VarChar(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchasePayments PurchasePayment[]
  salePayments     SalePayment[]
  vouchers         Voucher[]

  @@map("payment_methods")
}

// ============================================================
// الإعدادات العامة للنظام (SystemSettings) - صف واحد فقط (id = 1)
// purchaseTaxMode: وضع الأسعار الافتراضي في فواتير المشتريات
//   exclusive = غير شامل الضريبة / inclusive = شامل الضريبة / none = بدون ضريبة
// ============================================================

model SystemSettings {
  id              Int    @id
  purchaseTaxMode String @default("exclusive") @db.VarChar(10)

  // الضريبة: نسبة الضريبة في البرنامج (0 لو الشركة غير مسجلة في الضريبة)
  // تُستخدم كقيمة افتراضية للأصناف الجديدة
  taxRate Decimal @default(15) @db.Decimal(5, 2)

  // الأصناف: السعر الذي يُسجّل للصنف الجديد شامل الضريبة؟
  productPriceIncludesTax Boolean @default(false)

  // المخزون: السماح بالبيع (أو الإخراج) بأكثر من الرصيد
  // الرصيد يصبح سالباً، وأي بضاعة تدخل بعدها تُخصم منه تلقائياً
  allowNegativeStock Boolean @default(false)

  // الأرقام التسلسلية (وحدة serials): إلزام إدخالها لكل قطعة متتبعة عند البيع
  serialRequired Boolean @default(true)

  // الفواتير: نفس الصنف يتكرر في أكتر من سطر (كل سطر بوصفه) بدل ما الكمية تزيد
  // مثال: صنف "أعمال" ← أعمال نجارة / أعمال حدادة / أعمال سباكة
  allowDuplicateLines Boolean @default(false)
  // اسم مقدم الخدمة حسب النشاط (وحدة technicians):
  // technician فني | staff عاملة | barber حلاق | therapist معالج
  staffTitle String @default("technician") @db.VarChar(12)

  // الحجوزات (وحدة bookings): الحجز أونلاين من لينك + مواعيد العمل
  bookingOnline    Boolean @default(false)
  bookingOpen      String  @default("10:00") @db.VarChar(5)
  bookingClose     String  @default("22:00") @db.VarChar(5)
  bookingSlotMin   Int     @default(30)
  bookingDaysAhead Int     @default(30)
  bookingHome      Boolean @default(false)
  bookingNote      String? @db.VarChar(500)

  // بداية يوم العمل (ساعة بتوقيت السعودية): 0 = منتصف الليل (اليوم العادي)
  // مثال 5: اللي بعد نص الليل لحد 4:59 الفجر يتحسب على اليوم اللي قبله
  // (الورديات + تقارير المبيعات والمشتريات والأرباح واليومية + الرئيسية)
  dayStartHour Int @default(0)

  // النسخ الاحتياطي: مجلد الحفظ على السيرفر (فاضي = مجلد backups جوه المشروع)
  backupDir String? @db.VarChar(500)

  // النسخ الاحتياطي التلقائي (لمالك البرنامج)
  // backupFrequency: hours (كل backupEveryHours ساعة) | daily (كل يوم backupTime) | weekly (backupWeekday + backupTime)
  // backupKeep: عدد النسخ التلقائية اللي تتساب (الأقدم تتمسح) - 0 = كلها
  backupAutoEnabled   Boolean   @default(false)
  backupFrequency     String    @default("daily") @db.VarChar(8)
  backupEveryHours    Int       @default(12)
  backupTime          String    @default("03:00") @db.VarChar(5)
  backupWeekday       Int       @default(5) // 0 = الأحد ... 6 = السبت
  backupKeep          Int       @default(14)
  backupAutoSince     DateTime? // من إمتى اتشغّل (عشان مايعملش نسخ عن مواعيد قبل التشغيل)
  lastAutoBackupAt    DateTime?
  lastAutoBackupOk    Boolean?
  lastAutoBackupError String?   @db.VarChar(500)
  lastAutoBackupFile  String?   @db.VarChar(200)

  // باركود الميزان (الأصناف الموزونة) - نفس إعدادات برنامج الميزان
  // scaleFormat: علامة+صنف+وزن/سعر(+إجمالي)+تحقق، مثال 1+6+5+1
  // scaleValueType: weight وزن/عدد | total الإجمالي (السعر)
  scaleEnabled        Boolean @default(false)
  scaleFormat         String  @default("1+6+5+1") @db.VarChar(12)
  scaleFlag           String  @default("1") @db.VarChar(2)
  scaleValueType      String  @default("weight") @db.VarChar(6)
  scaleWeightDecimals Int     @default(3)
  scaleMoneyDecimals  Int     @default(2)

  // لغة البرنامج الافتراضية (ar / en) + هل يستخدم لغة المتصفح لو المستخدم مااختارش
  defaultLocale   String  @default("en") @db.VarChar(2)
  localeDetection Boolean @default(true)


  // المغسلة (وحدة laundry): مدة الاشتراك بالشهور (0 = لحد ما الرصيد يخلص)
  // ومكافأة الاشتراك تنزل خصم في الفاتورة
  laundryWalletMonths  Int     @default(0)
  laundryBonusDiscount Boolean @default(true)

  // المطعم (وحدة restaurant) - 0 = مقفولة، وكل رسوم سطر في الفاتورة عليه ضريبة:
  // رسوم الخدمة: النسبة الافتراضية (بتتغير في الفاتورة)، والمحلي بس ولا كل الطلبات
  // رسوم التوصيل: المبلغ الافتراضي | رسوم التبغ: نسبة على صافي أصناف التبغ
  // *ProductId: صنف الخدمة اللي السطر بيتسجل بيه (بيتعمل لوحده من الإعدادات)
  // الخدمة والتبغ: Type percent نسبة | amount مبلغ شامل الضريبة (التبغ: على كل وحدة)
  restaurantServiceType       String  @default("percent") @db.VarChar(10)
  restaurantServicePercent    Decimal @default(0) @db.Decimal(18, 4)
  restaurantServiceDineInOnly Boolean @default(true)
  restaurantDeliveryFee       Decimal @default(0) @db.Decimal(18, 4)
  restaurantTobaccoType       String  @default("percent") @db.VarChar(10)
  restaurantTobaccoPercent    Decimal @default(0) @db.Decimal(18, 4)
  restaurantServiceProductId  Int?
  restaurantDeliveryProductId Int?
  restaurantTobaccoProductId  Int?
  // الطلب الأونلاين (لينك /order/<كود الشركة>): مواعيد الاستقبال (توقيت السعودية)
  // prepMin: أقرب ميعاد وصول = دلوقتي + وقت التحضير | slotMin: فترة المواعيد
  restaurantOnline      Boolean @default(false)
  restaurantOnlineOpen  String  @default("10:00") @db.VarChar(5)
  restaurantOnlineClose String  @default("23:00") @db.VarChar(5)
  restaurantPrepMin     Int     @default(20)
  restaurantSlotMin     Int     @default(15)
  restaurantCurbside    Boolean @default(true)
  restaurantOnlineNote  String? @db.VarChar(500)
  // مدة جلسة الطاولة (دقايق) + حجز الطاولة من الأونلاين
  restaurantTableMinutes Int     @default(90)
  restaurantOnlineDineIn Boolean @default(true)
  // كاشير المطعم: نوع الطلب الافتراضي (local / dinein / takeaway / delivery / app)
  // + الطاولة الافتراضية لطلبات الطاولات لو الكاشير ماختارش
  restaurantDefaultOrderType String  @default("takeaway") @db.VarChar(10)
  restaurantDefaultTableId   Int?

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ============================================================
// مسلسل المستندات: آخر رقم مستخدم لكل نوع (purchase / purchase_return ...)
// يزيد داخل transaction فلا يتكرر رقم ولا تحدث فجوات
// ============================================================

model DocumentSequence {
  key  String @id @db.VarChar(30)
  last Int    @default(0)

  @@map("document_sequences")
}

// ============================================================
// المشتريات (Purchase): فاتورة الشراء ومرتجع الشراء في نفس الجدول
// - type: purchase = فاتورة شراء / return = مرتجع مشتريات
// - المرتجع مربوط بفاتورته الأصلية (returnOfId)
// - الفاتورة بعد الحفظ لا تُعدل ولا تُحذف، والتصحيح يكون بمرتجع
// - كل المبالغ محفوظة كما كانت وقت التسجيل (لا تتأثر بتغيير الإعدادات أو الأصناف)
// ============================================================

model Purchase {
  id     Int    @id @default(autoincrement())
  type   String @db.VarChar(10)
  number Int // مسلسل مستقل لكل نوع

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // المستودع الذي دخلت إليه البضاعة (أو خرجت منه في المرتجع)
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  // نسخة من بيانات المورد وقت التسجيل (تظهر في الطباعة)
  supplierArName String  @db.VarChar(255)
  supplierEnName String  @db.VarChar(255)
  supplierTaxNo  String? @db.VarChar(15)

  // فاتورة المورد: رقمها (للبحث ومنع التكرار) وتاريخها
  supplierInvoiceNo   String?   @db.VarChar(50)
  supplierInvoiceDate DateTime? @db.Date

  // تاريخ التسجيل عندنا (عليه يُحسب المخزن والتقارير)
  date DateTime

  // وضع الأسعار: exclusive / inclusive / none
  taxMode String @db.VarChar(10)

  // خصم الفاتورة: percent = نسبة / amount = مبلغ
  discountType  String  @default("amount") @db.VarChar(10)
  discountValue Decimal @default(0) @db.Decimal(18, 4)

  // الإجماليات
  subtotal         Decimal @default(0) @db.Decimal(18, 4) // الكمية × السعر (كما أُدخل)
  itemsDiscount    Decimal @default(0) @db.Decimal(18, 4) // مجموع خصومات الأصناف
  invoiceDiscount  Decimal @default(0) @db.Decimal(18, 4) // خصم الفاتورة
  netAmount        Decimal @default(0) @db.Decimal(18, 4) // الصافي قبل الضريبة
  taxAmount        Decimal @default(0) @db.Decimal(18, 4) // الضريبة
  totalAmount      Decimal @default(0) @db.Decimal(18, 4) // الإجمالي النهائي
  paidAmount       Decimal @default(0) @db.Decimal(18, 4) // المدفوع
  remainingAmount  Decimal @default(0) @db.Decimal(18, 4) // المتبقي (آجل على المورد)
  settledAmount    Decimal @default(0) @db.Decimal(18, 4) // المسدد بعدها بسندات صرف/تسوية

  allocations VoucherAllocation[]

  notes String? @db.VarChar(500)

  // المرتجع: الفاتورة الأصلية
  returnOfId Int?
  returnOf   Purchase?  @relation("PurchaseReturns", fields: [returnOfId], references: [id], onDelete: Restrict)
  returns    Purchase[] @relation("PurchaseReturns")

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // بصمة الحفظ (idempotency): نفس الطلب لو اتبعت تاني يرجّع نفس المستند بدل ما يتكرر
  requestId   String? @unique @db.VarChar(36)

  items    PurchaseItem[]
  payments PurchasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, number])
  // نفس رقم فاتورة المورد لا يتكرر لنفس المورد
  @@unique([type, supplierId, supplierInvoiceNo])
  @@index([supplierInvoiceNo])
  @@index([date])
  @@index([supplierId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([returnOfId])
  @@index([createdById])
  @@map("purchases")
}

// أصناف فاتورة المشتريات (أو المرتجع)
model PurchaseItem {
  id Int @id @default(autoincrement())

  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // نسخة من بيانات الصنف وقت التسجيل
  code   String @db.VarChar(50)
  arName String @db.VarChar(150)
  enName String @db.VarChar(150)

  // ملاحظة / وصف السطر (بتظهر تحت الصنف وفي الطباعة)
  note String? @db.VarChar(500)

  // الوحدة ومعامل التحويل (الوحدة الأساسية = 1)
  unitId Int
  unit   Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  factor Decimal @default(1) @db.Decimal(18, 4)

  qty     Decimal @db.Decimal(18, 3) // بالوحدة المختارة
  baseQty Decimal @db.Decimal(18, 4) // بالوحدة الأساسية (للمخزن)
  price   Decimal @db.Decimal(18, 4) // سعر الوحدة كما أُدخل (حسب وضع الضريبة)

  // خصم الصنف: percent / amount
  discountType  String  @default("amount") @db.VarChar(10)
  discountValue Decimal @default(0) @db.Decimal(18, 4)
  itemDiscount    Decimal @default(0) @db.Decimal(18, 4) // خصم الصنف بالمبلغ
  invoiceDiscount Decimal @default(0) @db.Decimal(18, 4) // نصيبه من خصم الفاتورة

  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  netAmount   Decimal @default(0) @db.Decimal(18, 4) // الصافي قبل الضريبة
  taxAmount   Decimal @default(0) @db.Decimal(18, 4)
  totalAmount Decimal @default(0) @db.Decimal(18, 4)

  // فاتورة الشراء: الكمية التي رُجّعت منه حتى الآن
  returnedQty Decimal @default(0) @db.Decimal(18, 3)

  // المرتجع: السطر الأصلي في فاتورة الشراء
  returnOfItemId Int?
  returnOfItem   PurchaseItem?  @relation("PurchaseItemReturns", fields: [returnOfItemId], references: [id], onDelete: Restrict)
  returnItems    PurchaseItem[] @relation("PurchaseItemReturns")

  // الأرقام التسلسلية اللي اتسجلت مع الشراء (اختياري)
  serials         ProductSerial[] @relation("SerialPurchase")
  // القطع اللي رجعت للمورد بسطر المرتجع ده
  returnedSerials ProductSerial[] @relation("SerialPurchaseReturn")

  @@index([purchaseId])
  @@index([productId])
  @@index([unitId])
  @@index([returnOfItemId])
  @@map("purchase_items")
}

// مدفوعات فاتورة المشتريات (كاش، تحويل ... يمكن أكثر من طريقة)
// الآجل ليس سطراً هنا: هو المتبقي في الفاتورة
model PurchasePayment {
  id Int @id @default(autoincrement())

  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  amount    Decimal @db.Decimal(18, 4)
  reference String? @db.VarChar(100)

  @@index([purchaseId])
  @@index([paymentMethodId])
  @@map("purchase_payments")
}

// ============================================================
// المستودعات (المخازن)
// - كل فرع مربوط بمستودع (الافتراضي)، وأكثر من فرع ممكن على نفس المستودع
// - المستودع الرئيسي (isMain): الرصيد الافتتاحي للأصناف يُسجل عليه
// ============================================================

model Warehouse {
  id       Int     @id @default(autoincrement())
  arName   String  @unique @db.VarChar(100)
  enName   String  @unique @db.VarChar(100)
  isMain   Boolean @default(false)
  isActive Boolean @default(true)
  notes    String? @db.VarChar(255)

  branches     Branch[]
  purchases    Purchase[]
  balances     StockBalance[]
  // الأصناف المتاحة في المستودع (للأصناف اللي مش متاحة في كل المستودعات)
  products     ProductWarehouse[]
  movements    StockMovement[]
  transfersOut StockTransfer[]  @relation("TransferFrom")
  adjustments  StockAdjustment[]
  transfersIn  StockTransfer[]  @relation("TransferTo")
  counts       InventoryCount[]
  sales        Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

// الصنف في مستودع: متاح فيه + رصيده الافتتاحي هناك
// - الصف موجود = الصنف متاح في المستودع (لو الصنف مش متاح في كل المستودعات)
// - الرصيد الافتتاحي بالوحدة اللي اتكتب بيها (openingUnitId فاضي = الأساسية)
//   وبيتحول لحركة opening على المستودع ده (رصيد المستودع الرئيسي في الصنف نفسه)
// - أي بضاعة بتدخل المستودع (تحويل / شراء...) بتعمل الصف لوحدها
model ProductWarehouse {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  openingQty    Decimal @default(0) @db.Decimal(18, 3)
  openingUnitId Int?

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("product_warehouses")
}

// رصيد كل صنف في كل مستودع (بالوحدة الأساسية)
// = مجموع الحركات، ومحفوظ جاهزاً للسرعة (يتحدث مع كل حركة)
model StockBalance {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  qty Decimal @default(0) @db.Decimal(18, 4)

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock_balances")
}

// حركات المخزون: كل دخول وخروج من أي مستند (كارت الصنف)
// qty: موجب = دخول، سالب = خروج (بالوحدة الأساسية)
// type: opening / purchase / purchase_return / transfer_out / transfer_in /
//       transfer_cancel / count / sale / sale_return
// refType + refId: المستند (purchase / transfer / count / product للافتتاحي)
model StockMovement {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  qty  Decimal @db.Decimal(18, 4)
  cost Decimal @default(0) @db.Decimal(18, 4) // تكلفة الوحدة الأساسية وقت الحركة

  type    String  @db.VarChar(20)
  refType String  @db.VarChar(20)
  refId   Int
  refNo   String? @db.VarChar(30) // رقم المستند للعرض (PI-5، TR-2 ...)

  date      DateTime
  createdAt DateTime @default(now())

  @@index([productId, warehouseId, date])
  @@index([warehouseId])
  @@index([refType, refId])
  @@map("stock_movements")
}

// ============================================================
// التحويلات المخزنية (خطوتين)
// 1) إرسال: تخرج البضاعة من المستودع المُرسِل (status = sent، في الطريق)
// 2) استلام: تدخل المستودع المستلِم (status = received)
// إلغاء قبل الاستلام: ترجع للمرسِل (status = cancelled)
// ============================================================

model StockTransfer {
  id     Int    @id @default(autoincrement())
  number Int    @unique
  status String @default("sent") @db.VarChar(10)

  fromWarehouseId Int
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)

  toWarehouseId Int
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  date       DateTime // تاريخ الإرسال
  receivedAt DateTime?
  notes      String?   @db.VarChar(500)

  createdById  Int
  createdBy    User  @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  receivedById Int?
  receivedBy   User? @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  items StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdById])
  @@index([receivedById])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id Int @id @default(autoincrement())

  transferId Int
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  code   String @db.VarChar(50)
  arName String @db.VarChar(150)
  enName String @db.VarChar(150)

  unitId Int
  unit   Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  factor Decimal @default(1) @db.Decimal(18, 4)

  qty         Decimal  @db.Decimal(18, 3) // المُرسَل بالوحدة المختارة
  baseQty     Decimal  @db.Decimal(18, 4) // المُرسَل بالوحدة الأساسية
  receivedQty Decimal? @db.Decimal(18, 3) // المُستلَم فعلاً (بالوحدة المختارة)
  cost        Decimal  @default(0) @db.Decimal(18, 4) // تكلفة الوحدة الأساسية وقت الإرسال

  @@index([transferId])
  @@index([productId])
  @@index([unitId])
  @@map("stock_transfer_items")
}

// ============================================================
// التوالف والزيادات: تالف (damage) بينزل من المخزون، زيادة (surplus) بتتضاف
// السبب لكل سطر، والتكلفة = تكلفة الصنف وقت المستند
// الإلغاء بيرجّع الحركات (المستند بيفضل للسجل)
// ============================================================
model StockAdjustment {
  id     Int    @id @default(autoincrement())
  number Int    @unique // AJ-1
  type   String @db.VarChar(10) // damage | surplus
  status String @default("posted") @db.VarChar(10) // posted | cancelled

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  date        DateTime
  notes       String?   @db.VarChar(500)
  cancelledAt DateTime?

  createdById Int
  createdBy   User @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items StockAdjustmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@index([createdById])
  @@index([type, status])
  @@index([date])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id Int @id @default(autoincrement())

  adjustmentId Int
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  code   String @db.VarChar(50)
  arName String @db.VarChar(150)
  enName String @db.VarChar(150)

  unitId Int
  unit   Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  factor Decimal @default(1) @db.Decimal(18, 4)

  qty     Decimal @db.Decimal(18, 3) // بالوحدة المختارة
  baseQty Decimal @db.Decimal(18, 4) // بالوحدة الأساسية
  cost    Decimal @default(0) @db.Decimal(18, 4) // تكلفة الوحدة الأساسية
  reason  String? @db.VarChar(255)

  // الأرقام التسلسلية: اللي دخلت بالزيادة / اللي اتلفت
  surplusSerials ProductSerial[] @relation("SerialSurplus")
  damagedSerials ProductSerial[] @relation("SerialDamage")

  @@index([adjustmentId])
  @@index([productId])
  @@index([unitId])
  @@map("stock_adjustment_items")
}

// ============================================================
// الجرد: مسودة (نكتب الكميات الفعلية) ← ترحيل (الفرق يصبح حركة مخزون)
// الكميات بالوحدة الأساسية
// ============================================================

model InventoryCount {
  id     Int    @id @default(autoincrement())
  number Int    @unique
  status String @default("draft") @db.VarChar(10) // draft / posted

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  date     DateTime
  postedAt DateTime?
  notes    String?   @db.VarChar(500)

  createdById Int
  createdBy   User  @relation("CountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedById  Int?
  postedBy    User? @relation("CountPostedBy", fields: [postedById], references: [id], onDelete: Restrict)

  items InventoryCountItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@index([createdById])
  @@index([postedById])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id Int @id @default(autoincrement())

  countId Int
  inventoryCount InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  systemQty  Decimal @default(0) @db.Decimal(18, 4) // رصيد البرنامج وقت الترحيل
  countedQty Decimal @db.Decimal(18, 4) // الموجود فعلاً
  diffQty    Decimal @default(0) @db.Decimal(18, 4) // الفعلي - البرنامج
  cost       Decimal @default(0) @db.Decimal(18, 4)

  @@unique([countId, productId])
  @@index([productId])
  @@map("inventory_count_items")
}

// ============================================================
// قوائم الأسعار: سعر مختلف للصنف حسب الفرع (أو العميل لاحقاً)
// الصنف بدون سعر في القائمة ← سعره الأساسي
// ============================================================

model PriceList {
  id       Int     @id @default(autoincrement())
  arName   String  @unique @db.VarChar(100)
  enName   String  @unique @db.VarChar(100)
  isActive Boolean @default(true)
  notes    String? @db.VarChar(255)

  prices   ProductPrice[]
  branches Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("price_lists")
}

// سعر صنف بوحدة معيّنة في قائمة أسعار
model ProductPrice {
  id Int @id @default(autoincrement())

  priceListId Int
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  price Decimal @db.Decimal(18, 4)

  updatedAt DateTime @updatedAt

  @@unique([priceListId, productId, unitId])
  @@index([productId])
  @@index([unitId])
  @@map("product_prices")
}

// ============================================================
// المبيعات: فاتورة البيع ومرتجع البيع في جدول واحد
// type: sale = فاتورة بيع / return = مرتجع مبيعات (مربوط بفاتورته)
// الضريبة لكل صنف حسب شاشة الصنف (نسبته، وهل سعره شامل الضريبة)
// ============================================================
model Sale {
  id     Int    @id @default(autoincrement())
  type   String @db.VarChar(10)
  number Int // مسلسل مستقل لكل نوع (SI-15 / SR-7)

  // من أين سُجلت: pos = شاشة الكاشير / invoice = فاتورة عادية
  source String @default("invoice") @db.VarChar(10)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // المستودع الذي خرجت منه البضاعة (أو رجعت إليه في المرتجع)
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // وردية الكاشير (المبيعات النقدية تُحسب في درجها)
  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  // العميل: فاضي = عميل نقدي
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // نسخة من بيانات العميل وقت البيع (تظهر في الطباعة)
  customerArName String? @db.VarChar(255)
  customerEnName String? @db.VarChar(255)
  customerTaxNo  String? @db.VarChar(15)
  // فاتورة تصدير (خارج المملكة): ضريبة صفرية VATEX-SA-32 + فاتورة ضريبية للهيئة
  isExport Boolean @default(false)

  // السيارة (وحدة vehicles) + نسخة من بياناتها وقت البيع + قراءة العداد
  vehicleId    Int?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehiclePlate String?  @db.VarChar(30)
  vehicleType  String?  @db.VarChar(100)
  odometer     Int?

  date DateTime

  // خصم الفاتورة: percent = نسبة / amount = مبلغ
  discountType  String  @default("amount") @db.VarChar(10)
  discountValue Decimal @default(0) @db.Decimal(18, 4)

  // الإجماليات
  subtotal        Decimal @default(0) @db.Decimal(18, 4)
  itemsDiscount   Decimal @default(0) @db.Decimal(18, 4)
  invoiceDiscount Decimal @default(0) @db.Decimal(18, 4)
  netAmount       Decimal @default(0) @db.Decimal(18, 4) // الصافي قبل الضريبة
  taxAmount       Decimal @default(0) @db.Decimal(18, 4)
  totalAmount     Decimal @default(0) @db.Decimal(18, 4)
  paidAmount      Decimal @default(0) @db.Decimal(18, 4)
  remainingAmount Decimal @default(0) @db.Decimal(18, 4) // آجل على العميل
  // الكاشير: المبلغ الذي استلمه نقداً والباقي الذي رجّعه للعميل
  tenderedAmount  Decimal @default(0) @db.Decimal(18, 4)
  changeAmount    Decimal @default(0) @db.Decimal(18, 4)
  // التكلفة (لتقرير الأرباح)
  costAmount      Decimal @default(0) @db.Decimal(18, 4)
  // المسدد بعد الفاتورة بسندات قبض/تسوية (من أقدم فاتورة تلقائياً)
  settledAmount   Decimal @default(0) @db.Decimal(18, 4)

  notes String? @db.VarChar(500)

  allocations VoucherAllocation[]

  // المرتجع: الفاتورة الأصلية
  returnOfId Int?
  returnOf   Sale?  @relation("SaleReturns", fields: [returnOfId], references: [id], onDelete: Restrict)
  returns    Sale[] @relation("SaleReturns")

  // الفاتورة المحوّلة من عرض سعر
  quotation Quotation?
  // فاتورة طلب صيانة
  warrantyClaim WarrantyClaim?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // بصمة الحفظ (idempotency): نفس الطلب لو اتبعت تاني يرجّع نفس المستند بدل ما يتكرر
  requestId   String? @unique @db.VarChar(36)

  // عرض على إجمالي الفاتورة (لو اتطبق)
  promotionId Int?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  items    SaleItem[]
  // المتابعة الدورية: اللي اتعملت بالفاتورة دي + تجديداتها
  followUpsCreated FollowUp[]    @relation("FollowUpOrigin")
  // الحجز اللي اتعملت منه الفاتورة
  bookings         Booking[]
  followUpLogs     FollowUpLog[] @relation("FollowUpLogSale")
  payments SalePayment[]

  // الفاتورة الإلكترونية (لو الفرع مربوط بالزكاة)
  zatcaDocument ZatcaDocument?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // المغسلة (وحدة laundry): طلبات الاستلام
  laundryOrders LaundryOrder[]
  // المطعم: طلب الكاشير اللي الفاتورة دي بتاعته (رقمه اليومي ونوعه)
  restaurantOrder RestaurantOrder?
  // المغسلة (وحدة laundry): الاشتراكات
  laundryWalletUses LaundryWalletUse[]
  @@unique([type, number])
  @@index([date])
  @@index([branchId])
  @@index([warehouseId])
  @@index([shiftId])
  @@index([customerId])
  @@index([returnOfId])
  @@index([createdById])
  @@index([promotionId])
  @@index([vehicleId])
  @@map("sales")
}

model SaleItem {
  id Int @id @default(autoincrement())

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  code   String @db.VarChar(50)
  arName String @db.VarChar(150)
  enName String @db.VarChar(150)

  // ملاحظة / وصف السطر (بتظهر تحت الصنف وفي الطباعة)
  note String? @db.VarChar(500)

  unitId Int
  unit   Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  factor Decimal @default(1) @db.Decimal(18, 4)

  qty     Decimal @db.Decimal(18, 3)
  baseQty Decimal @db.Decimal(18, 4)
  price   Decimal @db.Decimal(18, 4) // سعر الوحدة (شامل أو غير شامل حسب الصنف)

  // السعر شامل الضريبة؟ (من شاشة الصنف وقت البيع)
  priceIncludesTax Boolean @default(false)

  discountType    String  @default("amount") @db.VarChar(10)
  discountValue   Decimal @default(0) @db.Decimal(18, 4)
  itemDiscount    Decimal @default(0) @db.Decimal(18, 4)
  invoiceDiscount Decimal @default(0) @db.Decimal(18, 4)

  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  // فئة الضريبة وسبب الإعفاء وقت البيع (للفوترة الإلكترونية)
  taxCategory        String  @default("S") @db.VarChar(1)
  taxExemptionCode   String? @db.VarChar(20)
  taxExemptionReason String? @db.VarChar(255)
  netAmount   Decimal @default(0) @db.Decimal(18, 4)
  taxAmount   Decimal @default(0) @db.Decimal(18, 4)
  totalAmount Decimal @default(0) @db.Decimal(18, 4)

  // تكلفة الوحدة الأساسية وقت البيع، وإجمالي تكلفة السطر
  cost       Decimal @default(0) @db.Decimal(18, 4)
  costAmount Decimal @default(0) @db.Decimal(18, 4)

  // فاتورة البيع: الكمية التي رُجّعت منه حتى الآن
  returnedQty Decimal @default(0) @db.Decimal(18, 3)

  // المرتجع: السطر الأصلي في فاتورة البيع
  // عرض على الصنف (الخصم اتحسب منه تلقائياً)
  promotionId Int?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  // عرض الولاء (كل كام مرة ← مرة مجانية): عدد الوحدات اللي اتاخدت بالعرض في السطر ده
  loyaltyQty  Decimal?   @db.Decimal(18, 4)

  returnOfItemId Int?
  returnOfItem   SaleItem?  @relation("SaleItemReturns", fields: [returnOfItemId], references: [id], onDelete: Restrict)
  returnItems    SaleItem[] @relation("SaleItemReturns")

  // الضمان على السطر (من الصنف ويتعدل في الفاتورة): بالشهور + الجهة agent | store
  warrantyMonths Int?
  warrantyType   String? @db.VarChar(10)
  // الأرقام التسلسلية للقطع (البيع والمرتجع)
  serials        SaleItemSerial[]
  // المتابعة الدورية للجهاز اللي اتباع بالسطر ده
  followUps      FollowUp[]
  // القطع المباعة حاليًا بالسطر ده
  soldSerials    ProductSerial[]  @relation("SerialCurrentSale")

  // الفني والموعد (وحدة technicians): سطر خدمة (تركيب/صيانة) بيتنفذ عند العميل
  // jobStatus: pending مستني | done اتنفذ | cancelled اتلغى
  technicianId Int?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  jobAt        DateTime?
  jobAddress   String?     @db.VarChar(500)
  jobStatus    String?     @db.VarChar(12)
  jobDoneAt    DateTime?
  jobNote      String?     @db.VarChar(500)

  // التغيير الدوري للسيارة (زيت...): الغيار الجاي بالعداد و/أو بالتاريخ
  nextKm   Int?
  nextDate DateTime? @db.Date

  @@index([saleId])
  @@index([productId])
  @@index([unitId])
  @@index([returnOfItemId])
  @@index([promotionId])
  @@index([technicianId])
  @@index([jobAt])
  @@map("sale_items")
}

model SalePayment {
  id Int @id @default(autoincrement())

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  amount    Decimal @db.Decimal(18, 4)
  reference String? @db.VarChar(100)

  @@index([saleId])
  @@index([paymentMethodId])
  @@map("sale_payments")
}

// ============================================================
// عروض الأسعار: لا تؤثر على المخزون ولا الحسابات
// status: open = مفتوح / converted = تم تحويله لفاتورة
// ============================================================
model Quotation {
  id     Int    @id @default(autoincrement())
  number Int    @unique // QT-3
  status String @default("open") @db.VarChar(10)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // العميل: من العملاء، أو اسم يُكتب يدوياً (عميل غير مسجل)
  customerId     Int?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerArName String?   @db.VarChar(255)
  customerEnName String?   @db.VarChar(255)
  customerTaxNo  String?   @db.VarChar(15)

  date       DateTime
  validUntil DateTime @db.Date

  discountType    String  @default("amount") @db.VarChar(10)
  discountValue   Decimal @default(0) @db.Decimal(18, 4)
  subtotal        Decimal @default(0) @db.Decimal(18, 4)
  itemsDiscount   Decimal @default(0) @db.Decimal(18, 4)
  invoiceDiscount Decimal @default(0) @db.Decimal(18, 4)
  netAmount       Decimal @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal @default(0) @db.Decimal(18, 4)
  totalAmount     Decimal @default(0) @db.Decimal(18, 4)

  notes String? @db.VarChar(1000)

  // الفاتورة التي تحوّل إليها
  saleId Int?  @unique
  sale   Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  promotionId Int?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  items QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([createdById])
  @@index([date])
  @@index([promotionId])
  @@map("quotations")
}

model QuotationItem {
  id Int @id @default(autoincrement())

  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  code   String @db.VarChar(50)
  arName String @db.VarChar(150)
  enName String @db.VarChar(150)

  // ملاحظة / وصف السطر (بتظهر تحت الصنف وفي الطباعة)
  note String? @db.VarChar(500)

  unitId Int
  unit   Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  factor Decimal @default(1) @db.Decimal(18, 4)

  qty              Decimal @db.Decimal(18, 3)
  price            Decimal @db.Decimal(18, 4)
  priceIncludesTax Boolean @default(false)

  discountType    String  @default("amount") @db.VarChar(10)
  discountValue   Decimal @default(0) @db.Decimal(18, 4)
  itemDiscount    Decimal @default(0) @db.Decimal(18, 4)
  invoiceDiscount Decimal @default(0) @db.Decimal(18, 4)

  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  netAmount   Decimal @default(0) @db.Decimal(18, 4)
  taxAmount   Decimal @default(0) @db.Decimal(18, 4)
  totalAmount Decimal @default(0) @db.Decimal(18, 4)

  promotionId Int?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([productId])
  @@index([unitId])
  @@index([promotionId])
  @@map("quotation_items")
}

// ============================================================
// ورديات الكاشير: فتح برصيد أول المدة ← قفل بجرد الفلوس
// المتوقع في الدرج = أول المدة + المقبوض نقداً - المردود نقداً
// status: open / closed
// ============================================================
model Shift {
  id     Int    @id @default(autoincrement())
  number Int    @unique
  status String @default("open") @db.VarChar(10)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // الكاشير صاحب الوردية
  userId Int
  user   User @relation("ShiftCashier", fields: [userId], references: [id], onDelete: Restrict)

  openedAt    DateTime
  openingCash Decimal  @default(0) @db.Decimal(18, 4)

  // ترتيب الوردية في يوم العمل لكل فرع (الوردية 1 / 2 / 3) - بيتحسب وقت الفتح
  businessDay DateTime @db.Date
  dayNo       Int

  closedAt     DateTime?
  closedById   Int?
  closedBy     User?    @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  // الاستلام: المتروك في الدرج من الوردية السابقة على نفس الفرع، والفرق عند العدّ
  previousShiftId   Int?
  expectedOpening   Decimal? @db.Decimal(18, 4)
  openingDifference Decimal? @db.Decimal(18, 4)

  expectedCash Decimal? @db.Decimal(18, 4) // المفروض في الدرج وقت القفل
  countedCash  Decimal? @db.Decimal(18, 4) // الموجود فعلاً (جرد الكاشير)
  difference   Decimal? @db.Decimal(18, 4) // الموجود - المفروض (سالب = عجز)
  denominations Json?   // عدّ الفئات: { "500": 2, "100": 3, "coins": 12.5 }
  // الشبكة: إجمالي إيصال تقفيل الجهاز مقارنة بمبيعات الشبكة
  cardExpected   Decimal? @db.Decimal(18, 4)
  cardCounted    Decimal? @db.Decimal(18, 4)
  cardDifference Decimal? @db.Decimal(18, 4)
  // التسليم: المورّد للخزنة والمتروك في الدرج للوردية التالية
  depositedCash Decimal? @db.Decimal(18, 4)
  leftCash      Decimal? @db.Decimal(18, 4)

  notes String? @db.VarChar(500)

  sales         Sale[]
  vouchers      Voucher[]
  cashMovements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([closedById])
  @@unique([branchId, businessDay, dayNo])
  @@index([businessDay])
  @@map("shifts")
}

// ============================================================
// الحسابات: سندات القبض والصرف والتسوية
// type: receipt = قبض / payment = صرف / settlement = تسوية (خصم مسموح به / مكتسب)
// partyType: customer / supplier / expense (مصروف) / other (إيراد أو صرف متنوع)
// سند العميل/المورد يسدد من أقدم فاتورة تلقائياً (voucher_allocations)
// ============================================================
model ExpenseCategory {
  id       Int     @id @default(autoincrement())
  arName   String  @unique @db.VarChar(100)
  enName   String  @unique @db.VarChar(100)
  isActive Boolean @default(true)

  vouchers Voucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expense_categories")
}

model Voucher {
  id        Int    @id @default(autoincrement())
  type      String @db.VarChar(12)
  number    Int
  partyType String @db.VarChar(10)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // وردية الكاشير (السند النقدي يدخل/يخرج من درجه)
  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  expenseCategoryId Int?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  // اسم الطرف وقت التسجيل (يظهر في الطباعة)
  partyArName String? @db.VarChar(255)
  partyEnName String? @db.VarChar(255)

  // طريقة الدفع (التسوية بدون طريقة دفع: لا فلوس تتحرك)
  paymentMethodId Int?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  amount    Decimal @db.Decimal(18, 4)
  reference String? @db.VarChar(100)
  date      DateTime
  notes     String? @db.VarChar(500)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // بصمة الحفظ (idempotency): نفس الطلب لو اتبعت تاني يرجّع نفس المستند بدل ما يتكرر
  requestId   String? @unique @db.VarChar(36)

  allocations VoucherAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // المغسلة (وحدة laundry): الاشتراكات
  laundryWallet LaundryWallet?
  @@unique([type, number])
  @@index([branchId])
  @@index([shiftId])
  @@index([customerId])
  @@index([supplierId])
  @@index([expenseCategoryId])
  @@index([paymentMethodId])
  @@index([createdById])
  @@index([date])
  @@map("vouchers")
}

// توزيع السند على الفواتير (فاضي = على الرصيد الافتتاحي)
model VoucherAllocation {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  saleId     Int?
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  purchaseId Int?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(18, 4)

  @@index([voucherId])
  @@index([saleId])
  @@index([purchaseId])
  @@map("voucher_allocations")
}

// حركات الدرج اليدوية: سحب للخزنة (out) / إضافة فكة (in)
model CashMovement {
  id   Int    @id @default(autoincrement())
  type String @db.VarChar(5)

  shiftId Int
  shift   Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(18, 4)
  reason String? @db.VarChar(255)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([branchId])
  @@index([createdById])
  @@map("cash_movements")
}

// ============================================================
// العروض والخصومات لفترة
// scope: invoice (على إجمالي الفاتورة) | category (أقسام) | product (أصناف)
// discountType: percent | amount (من سعر الوحدة الأساسية) | fixedPrice (سعر ثابت للوحدة الأساسية)
//   (عرض الفاتورة: percent | amount فقط)
// الصنف عليه أكتر من عرض ← الأفضل للعميل، وعرض الفاتورة يتطبق فوق خصومات الأصناف
// ============================================================
model Promotion {
  id     Int    @id @default(autoincrement())
  arName String @db.VarChar(150)
  enName String @db.VarChar(150)

  scope        String  @db.VarChar(10)
  discountType String  @db.VarChar(12)
  value        Decimal @db.Decimal(18, 4)
  minInvoice   Decimal? @db.Decimal(18, 4) // عرض الفاتورة: أقل إجمالي للفاتورة
  // عرض الولاء (scope = loyalty): كل loyaltyEvery مرة مدفوعة ← المرة اللي بعدها بخصم value% (100 = مجانًا)
  // على loyaltyTarget: service كل الخدمات | category أقسام | product أصناف - لكل عميل مسجّل
  loyaltyEvery  Int?
  loyaltyTarget String?  @db.VarChar(10)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(true)

  // كل الفروع، أو الفروع المختارة فقط
  allBranches Boolean @default(true)
  branches    PromotionBranch[]
  categories  PromotionCategory[]
  products    PromotionProduct[]

  notes String? @db.VarChar(500)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  sales          Sale[]
  saleItems      SaleItem[]
  quotations     Quotation[]
  quotationItems QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([createdById])
  @@map("promotions")
}

model PromotionBranch {
  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branchId    Int
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([promotionId, branchId])
  @@index([branchId])
  @@map("promotion_branches")
}

model PromotionCategory {
  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@map("promotion_categories")
}

model PromotionProduct {
  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

// ============================================================
// الربط مع الزكاة (الفوترة الإلكترونية - المرحلة الثانية)
// وحدة (EGS) لكل فرع، مسجّلة على بيئة واحدة:
//   developer (بوابة المطورين) | simulation (المحاكاة) | production (الإنتاج)
// status: draft (البيانات اتحفظت) → csr (اتعمل CSR) → compliance (شهادة الامتثال)
//         → checked (فحص الامتثال نجح) → active (شهادة الإنتاج - جاهزة للفواتير)
// الأسرار (المفتاح الخاص والـ secrets) متشفرة AES-256-GCM بمفتاح ZATCA_MASTER_KEY في .env
// والشهادات نفسها عامة (مش سرية) فبتتخزن زي ما هي
// icv / lastHash: سلسلة الفواتير للوحدة (بتبدأ من الصفر مع كل تسجيل جديد)
// ============================================================
model ZatcaUnit {
  id       Int    @id @default(autoincrement())
  branchId Int    @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  environment String @db.VarChar(12)
  status      String @default("draft") @db.VarChar(12)

  // بيانات الـ CSR
  commonName           String  @db.VarChar(100)
  organizationUnitName String  @db.VarChar(100)
  invoiceType          String  @default("1100") @db.VarChar(4)
  locationAddress      String  @db.VarChar(150)
  industry             String  @db.VarChar(100)
  serialNumber         String? @db.VarChar(150)
  csr                  String? @db.Text
  privateKeyEnc        String? @db.Text

  // شهادة الامتثال
  complianceRequestId   String? @db.VarChar(50)
  complianceCertificate String? @db.Text
  complianceSecretEnc   String? @db.Text
  complianceChecks      Json? // نتيجة فحص كل نوع مستند

  // شهادة الإنتاج
  productionRequestId   String?   @db.VarChar(50)
  productionCertificate String?   @db.Text
  productionSecretEnc   String?   @db.Text
  certSerial            String?   @db.VarChar(100)
  certIssuedAt          DateTime?
  certExpiresAt         DateTime?
  onboardedAt           DateTime?

  // سلسلة الفواتير
  icv      Int     @default(0)
  lastHash String? @db.VarChar(100)

  logs      ZatcaLog[]
  documents ZatcaDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zatca_units")
}

// سجل عمليات الربط (التسجيل، الشهادات، الفحص، إعادة الضبط)
model ZatcaLog {
  id     Int       @id @default(autoincrement())
  unitId Int
  unit   ZatcaUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  action      String  @db.VarChar(30)
  environment String  @db.VarChar(12)
  success     Boolean
  message     String? @db.VarChar(1000)
  details     Json?
  userId      Int?
  userName    String? @db.VarChar(150)

  createdAt DateTime @default(now())

  @@index([unitId, createdAt])
  @@map("zatca_logs")
}

// ============================================================
// الفاتورة الإلكترونية لكل فاتورة بيع / مرتجع (إشعار دائن) في فرع مربوط
// - بتتوقّع وقت الحفظ: ICV (عداد الوحدة) + PIH (هاش اللي قبلها) + UUID ثابت
// - kind: simplified (أفراد - إبلاغ خلال 24 ساعة) | standard (شركات - اعتماد قبل التسليم)
// - docType: invoice | credit | debit
// - status: pending (موقّعة ولسه متبعتتش) | reported | cleared | rejected | error (فشل اتصال - إعادة محاولة)
// - signedXml: الـ XML الموقّع، clearedXml: المعتمد من الهيئة (للضريبية)
// - الفاتورة بعد التوقيع مقفولة (لا تعديل ولا حذف): التصحيح بإشعار دائن
// ============================================================
model ZatcaDocument {
  id     Int  @id @default(autoincrement())
  saleId Int  @unique
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  unitId Int
  unit   ZatcaUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  branchId    Int
  environment String @db.VarChar(12)
  kind        String @db.VarChar(10)
  docType     String @db.VarChar(10)

  icv  Int
  uuid String @db.VarChar(36)
  pih  String @db.VarChar(100)
  hash String @db.VarChar(100)
  qr   String @db.Text

  signedXml  String  @db.MediumText
  clearedXml String? @db.MediumText

  status        String    @default("pending") @db.VarChar(12)
  zatcaStatus   String?   @db.VarChar(30)
  httpStatus    Int?
  warnings      Json?
  errors        Json?
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  acceptedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, icv])
  @@index([status, createdAt])
  @@index([branchId, createdAt])
  @@map("zatca_documents")
}

// إعدادات الإرسال والتنبيهات (صف واحد id = 1)
model ZatcaSettings {
  id              Int     @id
  // الإرسال فور الحفظ (المبسطة) - الضريبية دايماً بتتعتمد وقت الحفظ
  sendOnSave      Boolean @default(true)
  // إرسال المعلّق تلقائياً في الخلفية كل intervalMinutes دقيقة
  autoSend        Boolean @default(true)
  intervalMinutes Int     @default(10)
  // تنبيه آخر اليوم: الساعة (HH:mm) والحد الأدنى لعدد الفواتير اللي متبعتتش
  alertTime       String  @default("22:00") @db.VarChar(5)
  alertThreshold  Int     @default(1)

  updatedAt DateTime @updatedAt

  @@map("zatca_settings")
}

// ============================================================
// الاشتراك (نسخة من لوحة التحكم)
// - لوحة التحكم هي اللي بتكتب هنا (وقت إنشاء القاعدة ومع كل تجديد / إيقاف / تغيير باقة)
// - البرنامج بيقرا منها بس: حالة الاشتراك والحدود، من غير ما يسأل اللوحة
// - مفيش أي شاشة بتعدّلها، والتصفير والاسترجاع مبيلمسوهاش
// ============================================================
model Subscription {
  id            Int       @id @default(1)
  companyCode   String    @db.VarChar(16)
  companySerial Int?
  // pending | active | suspended | cancelled
  status        String    @db.VarChar(20)
  suspendReason String?   @db.VarChar(255)
  // الباقة ومميزاتها (null = من غير باقة)
  planArName    String?   @db.VarChar(80)
  planEnName    String?   @db.VarChar(80)
  features      Json?
  // وحدات النشاط المفعّلة (null أو [] = البرنامج الأساسي بس)
  modules       Json?
  // الحدود الفعلية (حدود الشركة لو متحددة، وإلا حدود الباقة) - null = من غير حد
  maxUsers         Int?
  maxBranches      Int?
  maxInvoicesMonth Int?
  maxProducts      Int?
  // المدة (بالأيام) + فترة السماح والقراءة فقط بالأيام بعد النهاية
  startsAt      DateTime  @db.Date
  endsAt        DateTime  @db.Date
  graceDays     Int       @default(7)
  readonlyDays  Int       @default(14)
  expiringDays  Int       @default(7)
  // بيانات الشركة المالكة (الدعم الفني): اسم، لوجو، تليفونات، واتساب، إيميل، موقع، عنوان، مواعيد
  vendor        Json?
  // اسم مقدم الخدمة (ثابت للنشاط من اللوحة) - null = من الإعدادات العامة
  staffTitle    String?   @db.VarChar(12)
  // صلاحيات مقفولة على الشركة من اللوحة (حتى مدير النظام) ← لمالك البرنامج بس
  blockedPermissions Json?
  // آخر مرة اللوحة كتبت هنا
  syncedAt      DateTime

  @@map("subscription")
}

// سجل الاشتراك (نسخة من سجل اللوحة)
model SubscriptionLog {
  id         Int       @id
  // create | renew | plan | suspend | activate | cancel
  action     String    @db.VarChar(20)
  planArName String?   @db.VarChar(80)
  planEnName String?   @db.VarChar(80)
  startsAt   DateTime? @db.Date
  endsAt     DateTime? @db.Date
  amount     Decimal?  @db.Decimal(12, 2)
  note       String?   @db.VarChar(500)
  createdAt  DateTime

  @@map("subscription_log")
}

// ============================================================
// الأرقام التسلسلية (وحدة serials)
// - القطعة بتتسجل عند البيع (أو عند الشراء اختياريًا)
// - status: in_stock في المحل (اتسجلت في الشراء أو رجعت بمرتجع) | sold مباعة
// - الرقم مايتكررش لنفس الصنف، والمباع مايتباعش تاني إلا بعد مرتجعه
// ============================================================
model ProductSerial {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  serial  String  @db.VarChar(100)
  // الرقم التاني (IMEI 2 / الوحدة الخارجية)
  serial2 String? @db.VarChar(100)
  // returned: رجعت للمورد بمرتجع مشتريات
  status  String  @default("in_stock") @db.VarChar(12)
  // جهاز مستعمل
  isUsed  Boolean @default(false)

  // سطر الشراء (لو اتسجل وقت الشراء)
  purchaseItemId Int?
  purchaseItem   PurchaseItem? @relation("SerialPurchase", fields: [purchaseItemId], references: [id], onDelete: SetNull)
  // سطر مرتجع المشتريات (لو رجعت للمورد)
  purchaseReturnItemId Int?
  purchaseReturnItem   PurchaseItem? @relation("SerialPurchaseReturn", fields: [purchaseReturnItemId], references: [id], onDelete: SetNull)

  // التوالف والزيادات: القطعة دخلت بمستند زيادة / اتلفت بمستند تالف
  surplusItemId Int?
  surplusItem   StockAdjustmentItem? @relation("SerialSurplus", fields: [surplusItemId], references: [id], onDelete: SetNull)
  damageItemId  Int?
  damageItem    StockAdjustmentItem? @relation("SerialDamage", fields: [damageItemId], references: [id], onDelete: SetNull)

  // آخر بيع (فاضي لو في المحل)
  saleItemId Int?
  saleItem   SaleItem? @relation("SerialCurrentSale", fields: [saleItemId], references: [id], onDelete: SetNull)
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  soldAt     DateTime?

  // الضمان (من سطر البيع)
  warrantyMonths Int?
  warrantyType   String?   @db.VarChar(10)
  warrantyEndsAt DateTime? @db.Date

  // كل حركات القطعة (بيع ومرتجع)
  links SaleItemSerial[]
  // طلبات الضمان على القطعة / القطعة البديلة في طلب استبدال
  warrantyClaims   WarrantyClaim[] @relation("ClaimSerial")
  replacingClaims  WarrantyClaim[] @relation("ClaimNewSerial")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, serial])
  @@index([serial])
  @@index([serial2])
  @@index([status])
  @@index([purchaseItemId])
  @@index([purchaseReturnItemId])
  @@index([surplusItemId])
  @@index([damageItemId])
  @@index([saleItemId])
  @@index([customerId])
  @@index([warrantyEndsAt])
  @@map("product_serials")
}

// القطع في سطور البيع والمرتجع (تاريخ القطعة)
model SaleItemSerial {
  id Int @id @default(autoincrement())

  saleItemId Int
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  serialId Int
  serial   ProductSerial @relation(fields: [serialId], references: [id], onDelete: Cascade)

  // نسخة الرقم وقت الحركة (للطباعة)
  serialText  String  @db.VarChar(100)
  serial2Text String? @db.VarChar(100)

  @@unique([saleItemId, serialId])
  @@index([serialId])
  @@map("sale_item_serials")
}

// ============================================================
// طلبات الضمان والصيانة (وحدة warrantyClaims)
// kind: warranty ضمان | paid صيانة مدفوعة
// status: received مستلم → inspecting فحص → at_agent عند الوكيل → back رجع
//         → ready جاهز للتسليم → delivered تم التسليم | cancelled ملغي
// result: repaired اتصلّح | replaced اتبدّل | rejected مرفوض
// الفلوس: مفيش أي مبلغ قبل فاتورة الصيانة (saleId)
// ============================================================
model WarrantyClaim {
  id     Int    @id @default(autoincrement())
  number Int    @unique // WC-1
  kind   String @default("warranty") @db.VarChar(10)
  status String @default("received") @db.VarChar(12)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // العميل (أو اسمه وجواله لو مش مسجل)
  customerId    Int?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName  String?   @db.VarChar(255)
  customerPhone String?   @db.VarChar(30)

  // الجهاز: صنف عندنا أو اسم مكتوب (جهاز مش متباع من عندنا)
  productId   Int?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  deviceName  String?        @db.VarChar(255)
  serialId    Int?
  serial      ProductSerial? @relation("ClaimSerial", fields: [serialId], references: [id], onDelete: SetNull)
  serialText  String?        @db.VarChar(100)
  serial2Text String?        @db.VarChar(100)
  // الضمان وقت الاستلام
  inWarranty     Boolean   @default(false)
  warrantyEndsAt DateTime? @db.Date

  fault       String    @db.VarChar(1000)
  // الملحقات المستلمة: ["charger", "box", ...] + أخرى
  accessories Json?
  accessoriesOther String? @db.VarChar(255)
  condition   String?   @db.VarChar(500)
  expectedAt  DateTime? @db.Date
  estimate    Decimal?  @db.Decimal(18, 4)

  // الوكيل / المورد
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sentAt     DateTime?
  agentRef   String?   @db.VarChar(100)
  backAt     DateTime?

  // النتيجة
  result      String?        @db.VarChar(12)
  resultNote  String?        @db.VarChar(500)
  newSerialId Int?
  newSerial   ProductSerial? @relation("ClaimNewSerial", fields: [newSerialId], references: [id], onDelete: SetNull)

  // فاتورة الصيانة (القطع والمصنعية)
  saleId Int?  @unique
  sale   Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  deliveredAt DateTime?
  notes       String?   @db.VarChar(1000)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  items WarrantyClaimItem[]
  logs  WarrantyClaimLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([branchId])
  @@index([customerId])
  @@index([productId])
  @@index([serialId])
  @@index([supplierId])
  @@index([createdById])
  @@index([newSerialId])
  @@map("warranty_claims")
}

// قطع الغيار والمصنعية في طلب الصيانة (بتتحول لفاتورة)
model WarrantyClaimItem {
  id Int @id @default(autoincrement())

  claimId Int
  claim   WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitId    Int
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  qty       Decimal @db.Decimal(18, 3)
  price     Decimal @db.Decimal(18, 4)
  note      String? @db.VarChar(500)

  @@index([claimId])
  @@index([productId])
  @@index([unitId])
  @@map("warranty_claim_items")
}

// سجل الطلب: كل نقلة (مين وإمتى وملاحظة)
model WarrantyClaimLog {
  id Int @id @default(autoincrement())

  claimId Int
  claim   WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  status String  @db.VarChar(12)
  note   String? @db.VarChar(500)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([claimId])
  @@index([userId])
  @@map("warranty_claim_logs")
}

// ============================================================
// الفنيون (وحدة technicians): مش لازم يكونوا مستخدمين على البرنامج
// commissionRate: نسبة الفني (%) من صافي سطور الخدمات اللي نفذها
// ============================================================
model Technician {
  id             Int     @id @default(autoincrement())
  arName         String  @db.VarChar(100)
  enName         String  @db.VarChar(100)
  phone          String? @db.VarChar(30)
  // العمولة: commissionRate على الخدمات، productRate على بيع الأصناف (المستحضرات...)
  // + استثناءات لقسم أو صنف معين (rates): نسبة أو مبلغ ثابت على الوحدة
  commissionRate Decimal @default(0) @db.Decimal(5, 2)
  productRate    Decimal @default(0) @db.Decimal(5, 2)
  isActive       Boolean @default(true)
  notes          String? @db.VarChar(500)

  rates     TechnicianRate[]
  saleItems SaleItem[]
  bookings  Booking[]
  contracts MaintenanceContract[]
  visits    MaintenanceVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("technicians")
}

// استثناء عمولة لمقدم خدمة: على قسم (categoryId) أو صنف/خدمة (productId)
// rateType: percent نسبة من الصافي | amount مبلغ ثابت على كل وحدة
// الأولوية: الصنف ← القسم (أو القسم الأب) ← النسبة العامة
model TechnicianRate {
  id           Int         @id @default(autoincrement())
  technicianId Int
  technician   Technician  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  categoryId   Int?
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  rateType     String      @default("percent") @db.VarChar(10)
  value        Decimal     @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId])
  @@index([categoryId])
  @@index([productId])
  @@map("technician_rates")
}

// ============================================================
// عقود الصيانة الدورية (وحدة maintenanceContracts)
// - العقد على جهاز عند عميل: زيارة كل intervalMonths من startDate لحد endDate
// - الزيارات بتتولد مع العقد، وتتنفذ أو تتأجل أو تتلغى
// status: active ساري | ended منتهي | cancelled ملغي
// ============================================================
model MaintenanceContract {
  id     Int @id @default(autoincrement())
  number Int @unique // MC-1

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // الجهاز: صنف عندنا (اختياري) + اسم ورقم مكتوب
  productId  Int?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  deviceName String   @db.VarChar(255)
  serialText String?  @db.VarChar(100)
  address    String?  @db.VarChar(500)

  intervalMonths Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  // قيمة العقد (للعلم؛ الفلوس بفاتورة)
  amount         Decimal? @db.Decimal(18, 4)

  technicianId Int?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  status String  @default("active") @db.VarChar(12)
  notes  String? @db.VarChar(1000)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  visits MaintenanceVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([productId])
  @@index([technicianId])
  @@index([createdById])
  @@index([status])
  @@map("maintenance_contracts")
}

// زيارة صيانة دورية: pending مستنية | done اتنفذت | skipped اتلغت
model MaintenanceVisit {
  id Int @id @default(autoincrement())

  contractId Int
  contract   MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  dueDate DateTime  @db.Date
  status  String    @default("pending") @db.VarChar(10)
  doneAt  DateTime?
  note    String?   @db.VarChar(500)

  technicianId Int?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([dueDate])
  @@index([status])
  @@index([technicianId])
  @@map("maintenance_visits")
}


// ============================================================
// المتابعة الدورية (وحدة followUps) - الفلاتر والتحلية وأي جهاز ليه صيانة دورية
// - بتتعمل من فاتورة البيع: صنف عليه متابعة + "متابعة" على السطر (اختياري)
// - الميعاد الجاي = آخر مرة (فاتورة صيانة / تمت المتابعة) + كل كام يوم
// - فاتورة الصيانة بتجدد المتابعات اللي تختارها وقت الحفظ
// ============================================================
model FollowUp {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId   Int
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productId  Int?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  deviceName String   @db.VarChar(150)

  // الفاتورة والسطر اللي اتعملت بيهم
  originSaleId Int?
  originSale   Sale?     @relation("FollowUpOrigin", fields: [originSaleId], references: [id], onDelete: SetNull)
  saleItemId   Int?
  saleItem     SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  intervalDays Int
  place        String? @db.VarChar(100) // البيت / المحل / المطبخ ...
  address      String? @db.VarChar(500)
  locationUrl  String? @db.VarChar(500) // لينك خرائط جوجل
  phone        String? @db.VarChar(30)
  notes        String? @db.VarChar(500)

  lastDate DateTime @db.Date // آخر مرة (فاتورة / متابعة)
  nextDate DateTime @db.Date // الميعاد الجاي (بيتغير بالتأجيل)
  status   String   @default("active") @db.VarChar(10) // active | stopped

  createdById Int
  createdBy   User @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  logs FollowUpLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([productId])
  @@index([originSaleId])
  @@index([saleItemId])
  @@index([status, nextDate])
  @@index([createdById])
  @@map("follow_ups")
}

// سجل المتابعة: اتعملت / فاتورة صيانة / تمت / تأجيل / إيقاف / استئناف / تعديل
model FollowUpLog {
  id Int @id @default(autoincrement())

  followUpId Int
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  type String   @db.VarChar(12) // created | invoice | done | postponed | stopped | resumed | edited
  date DateTime
  note String?  @db.VarChar(500)

  // فاتورة الصيانة (أو المرتجع اللي وقّف المتابعة)
  saleId Int?
  sale   Sale? @relation("FollowUpLogSale", fields: [saleId], references: [id], onDelete: SetNull)

  // قبل التغيير (عشان حذف الفاتورة يرجّع الميعاد زي ما كان)
  prevLastDate DateTime? @db.Date
  prevNextDate DateTime? @db.Date
  nextDate     DateTime? @db.Date

  userId Int
  user   User @relation("FollowUpLogUser", fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([followUpId])
  @@index([saleId])
  @@index([userId])
  @@map("follow_up_logs")
}

// ============================================================
// السيارات (وحدة vehicles - الورش): رقم اللوحة هو اللي بيتبحث بيه
// plateKey: اللوحة من غير مسافات وبحروف كبيرة (عشان ما تتكررش)
// العميل اختياري (الزبون العابر: لوحة بس، والجوال اختياري)
// ============================================================
model Vehicle {
  id          Int       @id @default(autoincrement())
  plateNo     String    @db.VarChar(30)
  plateKey    String    @unique @db.VarChar(30)
  vehicleType String?   @db.VarChar(100)
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone       String?   @db.VarChar(30)
  notes       String?   @db.VarChar(500)

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([vehicleType])
  @@map("vehicles")
}

// ============================================================
// الحجوزات (وحدة bookings - الكوافير / الحلاق / المساج)
// status: booked محجوز | arrived وصل | done تم | cancelled ملغي | noShow لم يحضر
// source: staff من البرنامج | online من لينك الحجز
// العميل اختياري (الاسم والجوال كفاية) - الفاتورة: saleId
// ============================================================
model Booking {
  id           Int         @id @default(autoincrement())
  number       Int         @unique
  branchId     Int
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId   Int?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String      @db.VarChar(150)
  phone        String      @db.VarChar(30)
  technicianId Int?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  startAt      DateTime
  endAt        DateTime
  status       String      @default("booked") @db.VarChar(12)
  // خدمة في المنزل
  atHome       Boolean     @default(false)
  address      String?     @db.VarChar(500)
  locationUrl  String?     @db.VarChar(500)
  notes        String?     @db.VarChar(500)
  source       String      @default("staff") @db.VarChar(10)
  saleId       Int?
  sale         Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdById  Int?
  createdBy    User?       @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items BookingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([branchId])
  @@index([customerId])
  @@index([technicianId])
  @@index([phone])
  @@index([status])
  @@index([saleId])
  @@index([createdById])
  @@map("bookings")
}

model BookingItem {
  id          Int      @id @default(autoincrement())
  bookingId   Int
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  arName      String   @db.VarChar(255)
  enName      String   @db.VarChar(255)
  price       Decimal  @default(0) @db.Decimal(18, 4)
  durationMin Int      @default(0)

  @@index([bookingId])
  @@index([productId])
  @@map("booking_items")
}

// ============================================================
// المغسلة (وحدة laundry) - الأصناف والخدمات والإضافات
// - القطعة (ثوب، شماغ...) = صنف خدمة عادي + سطر هنا (صنف مغسلة)
// - السعر = القطعة × الخدمة: عادي + مستعجل (المستعجل null = مش متاح)
// - الإضافات (نشا، مرزام، علّاق...) من غير أسعار، في مجموعات
// ============================================================
model LaundryService {
  id        Int     @id @default(autoincrement())
  arName    String  @unique @db.VarChar(100)
  enName    String  @unique @db.VarChar(100)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  prices LaundryPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // المغسلة (وحدة laundry): طلبات الاستلام
  orderItems LaundryOrderItem[]
  @@map("laundry_services")
}

model LaundryItem {
  productId Int     @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // الترتيب في شاشة الاستلام
  sortOrder Int     @default(0)

  prices LaundryPrice[]

  createdAt DateTime @default(now())

  @@map("laundry_items")
}

// السطر موجود = الخدمة متاحة للقطعة دي
model LaundryPrice {
  id          Int            @id @default(autoincrement())
  productId   Int
  item        LaundryItem    @relation(fields: [productId], references: [productId], onDelete: Cascade)
  serviceId   Int
  service     LaundryService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price       Decimal        @default(0) @db.Decimal(18, 4)
  urgentPrice Decimal?       @db.Decimal(18, 4)

  @@unique([productId, serviceId])
  @@index([serviceId])
  @@map("laundry_prices")
}

// multiple = يختار أكتر من واحدة (غير كده واحدة بس، زي النشا)
model LaundryAddonGroup {
  id        Int     @id @default(autoincrement())
  arName    String  @unique @db.VarChar(100)
  enName    String  @unique @db.VarChar(100)
  multiple  Boolean @default(false)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  addons LaundryAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("laundry_addon_groups")
}

model LaundryAddon {
  id        Int               @id @default(autoincrement())
  groupId   Int
  group     LaundryAddonGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  arName    String            @db.VarChar(100)
  enName    String            @db.VarChar(100)
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([groupId, arName])
  @@unique([groupId, enName])
  @@map("laundry_addons")
}

// ============================================================
// المغسلة (وحدة laundry) - طلبات الاستلام
// - dailyNo: رقم يومي (يبدأ من 1 كل يوم عمل) لكل فرع، والـ id هو الرقم الفريد
//   (اللي في باركود الإيصال)
// - العميل إجباري (بالجوال) + نسخة من اسمه وجواله وقت الاستلام
// - status: received مستلَم | processing قيد التنفيذ | ready جاهز
//   | delivered مسلَّم | cancelled ملغي
// - saleId: الفاتورة، وفاتورة واحدة ممكن تجمع أكتر من طلب (الفاتورة المجمعة)
// ============================================================
model LaundryOrder {
  id           Int       @id @default(autoincrement())
  branchId     Int
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // يوم العمل (الإعدادات العامة ← بداية يوم العمل)
  bizDay       DateTime  @db.Date
  dailyNo      Int
  customerId   Int
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName String    @db.VarChar(255)
  phone        String    @db.VarChar(11)
  status       String    @default("received") @db.VarChar(12)
  // فيه سطر مستعجل (للترتيب والتمييز في اللوحة)
  isUrgent     Boolean   @default(false)
  totalQty     Int       @default(0)
  totalAmount  Decimal   @default(0) @db.Decimal(18, 4)
  notes        String?   @db.VarChar(500)
  saleId       Int?
  sale         Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  readyAt      DateTime?
  deliveredAt  DateTime?
  deliveredById Int?
  deliveredBy  User?     @relation("LaundryOrderDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull)
  cancelledAt  DateTime?
  cancelReason String?   @db.VarChar(255)
  createdById  Int
  createdBy    User      @relation("LaundryOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items LaundryOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([branchId, bizDay, dailyNo])
  @@index([bizDay])
  @@index([customerId])
  @@index([phone])
  @@index([status])
  @@index([saleId])
  @@index([deliveredById])
  @@index([createdById])
  @@map("laundry_orders")
}

// السطر: القطعة × الخدمة (عادي / مستعجل) × العدد + الإضافات
// الأسماء والسعر نسخة وقت الاستلام
// addons: [{ id, groupId, arName, enName }]
model LaundryOrderItem {
  id            Int             @id @default(autoincrement())
  orderId       Int
  order         LaundryOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  serviceId     Int?
  service       LaundryService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  arName        String          @db.VarChar(150)
  enName        String          @db.VarChar(150)
  serviceArName String          @db.VarChar(100)
  serviceEnName String          @db.VarChar(100)
  isUrgent      Boolean         @default(false)
  qty           Int             @default(1)
  price         Decimal         @default(0) @db.Decimal(18, 4)
  total         Decimal         @default(0) @db.Decimal(18, 4)
  addons        Json?
  notes         String?         @db.VarChar(255)

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@map("laundry_order_items")
}

// ============================================================
// المغسلة (وحدة laundry) - الاشتراكات (رصيد للعميل)
// - paidAmount اللي دفعه، creditAmount اللي اتشحن له (المكافأة = الفرق)
// - الفلوس بسند قبض (voucher) على الدرج، والرصيد بيتصرف في فواتير الكاشير
// - status: active | used (الرصيد خلص) | expired | cancelled
// ============================================================
model LaundryWallet {
  id           Int       @id @default(autoincrement())
  number       Int       @unique
  customerId   Int
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId     Int
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  paidAmount   Decimal   @default(0) @db.Decimal(18, 4)
  creditAmount Decimal   @default(0) @db.Decimal(18, 4)
  remaining    Decimal   @default(0) @db.Decimal(18, 4)
  expiresAt    DateTime? @db.Date
  status       String    @default("active") @db.VarChar(10)
  voucherId    Int?      @unique
  voucher      Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  notes        String?   @db.VarChar(255)
  createdById  Int
  createdBy    User      @relation("LaundryWalletCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  uses LaundryWalletUse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([customerId, status])
  @@index([branchId])
  @@index([createdById])
  @@map("laundry_wallets")
}

// الصرف من الاشتراك في فاتورة: credit = اللي اتخصم من الرصيد
// value = اللي اتدفع بيه في الفاتورة، bonus = خصم المكافأة (credit = value + bonus)
model LaundryWalletUse {
  id        Int           @id @default(autoincrement())
  walletId  Int
  wallet    LaundryWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  saleId    Int
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  credit    Decimal       @default(0) @db.Decimal(18, 4)
  value     Decimal       @default(0) @db.Decimal(18, 4)
  bonus     Decimal       @default(0) @db.Decimal(18, 4)
  createdAt DateTime      @default(now())

  @@index([walletId])
  @@index([saleId])
  @@map("laundry_wallet_uses")
}

// ============================================================
// المطعم / المقهى (وحدة restaurant): المنيو
// - الصنف = صنف عادي + RestaurantItem (ترتيبه وهل عليه رسوم تبغ)
// - الأحجام: كل صنف ليه سعر لكل حجم (من غير أحجام = سعره العادي)
// - الإضافات: مجموعات بحد أدنى/أقصى للاختيار، مربوطة بأصنافها
// - التطبيقات (SalesChannel): من لوحة التحكم، والصنف ممكن يتكتب له سعر خاص فيها
// ============================================================
model RestaurantItem {
  productId Int      @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  // رسوم التبغ (الشيشة...): نسبة الإعدادات على صافي السطر
  isTobacco Boolean  @default(false)
  // عدد الحبات (السمك...): الكاشير بيكتب الكيلو كام حبة (بيظهر في التحضير)
  askPieces Boolean  @default(false)
  createdAt DateTime @default(now())

  sizes         RestaurantItemSize[]
  groups        RestaurantItemGroup[]
  channelPrices RestaurantChannelPrice[]

  @@map("restaurant_items")
}

model RestaurantSize {
  id        Int     @id @default(autoincrement())
  arName    String  @unique @db.VarChar(100)
  enName    String  @unique @db.VarChar(100)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  items RestaurantItemSize[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurant_sizes")
}

// سعر الصنف لكل حجم (السطر موجود = الحجم متاح للصنف)
model RestaurantItemSize {
  id        Int            @id @default(autoincrement())
  productId Int
  item      RestaurantItem @relation(fields: [productId], references: [productId], onDelete: Cascade)
  sizeId    Int
  size      RestaurantSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  price     Decimal        @default(0) @db.Decimal(18, 4)

  @@unique([productId, sizeId])
  @@index([sizeId])
  @@map("restaurant_item_sizes")
}

// minSelect: 0 اختياري، 1+ إجباري | maxSelect: 0 بدون حد
model RestaurantModifierGroup {
  id        Int     @id @default(autoincrement())
  arName    String  @unique @db.VarChar(100)
  enName    String  @unique @db.VarChar(100)
  minSelect Int     @default(0)
  maxSelect Int     @default(0)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  modifiers RestaurantModifier[]
  items     RestaurantItemGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurant_modifier_groups")
}

model RestaurantModifier {
  id        Int                     @id @default(autoincrement())
  groupId   Int
  group     RestaurantModifierGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  arName    String                  @db.VarChar(100)
  enName    String                  @db.VarChar(100)
  // 0 = مجاناً
  price     Decimal                 @default(0) @db.Decimal(18, 4)
  sortOrder Int                     @default(0)
  isActive  Boolean                 @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, arName])
  @@unique([groupId, enName])
  @@map("restaurant_modifiers")
}

model RestaurantItemGroup {
  productId Int
  item      RestaurantItem          @relation(fields: [productId], references: [productId], onDelete: Cascade)
  groupId   Int
  group     RestaurantModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder Int                     @default(0)

  @@id([productId, groupId])
  @@index([groupId])
  @@map("restaurant_item_groups")
}

// التطبيقات (هنقرستيشن، جاهز...): من لوحة التحكم (templateKey = "C<رقم التطبيق>")
// markupType: percent نسبة | amount مبلغ (زيادة على سعر الصنف)
// commissionPercent: عمولة التطبيق من الصافي (التقارير)
model SalesChannel {
  id                Int     @id @default(autoincrement())
  templateKey       String  @unique @db.VarChar(20)
  arName            String  @db.VarChar(100)
  enName            String  @db.VarChar(100)
  markupType        String  @default("percent") @db.VarChar(10)
  markupValue       Decimal @default(0) @db.Decimal(18, 4)
  commissionPercent Decimal @default(0) @db.Decimal(7, 2)
  sortOrder         Int     @default(0)
  isActive          Boolean @default(true)

  prices RestaurantChannelPrice[]
  orders RestaurantOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales_channels")
}

// سعر خاص للصنف في التطبيق (sizeId = 0: الصنف من غير حجم)
// مش موجود = سعر الصنف + زيادة التطبيق
model RestaurantChannelPrice {
  id        Int            @id @default(autoincrement())
  productId Int
  item      RestaurantItem @relation(fields: [productId], references: [productId], onDelete: Cascade)
  channelId Int
  channel   SalesChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sizeId    Int            @default(0)
  price     Decimal        @default(0) @db.Decimal(18, 4)

  @@unique([productId, channelId, sizeId])
  @@index([channelId])
  @@map("restaurant_channel_prices")
}

// السائقين: commissionType percent نسبة من رسوم التوصيل | amount مبلغ على كل طلب
model RestaurantDriver {
  id              Int     @id @default(autoincrement())
  name            String  @unique @db.VarChar(100)
  phone           String? @db.VarChar(30)
  commissionType  String  @default("amount") @db.VarChar(10)
  commissionValue Decimal @default(0) @db.Decimal(18, 4)
  isActive        Boolean @default(true)

  orders RestaurantOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurant_drivers")
}

// طلبات الكاشير (المطعم): رقم يومي لكل فرع يبدأ من 1
// orderType: local محلي (من غير طاولة) | dinein طاولات | takeaway سفري | delivery توصيل | app تطبيق
// status: open طاولة مفتوحة (السطور في lines لحد الفاتورة) | paid اتفوتر | cancelled ملغي
model RestaurantOrder {
  id             Int               @id @default(autoincrement())
  branchId       Int
  bizDay         DateTime          @db.Date
  dailyNo        Int
  orderType      String            @default("takeaway") @db.VarChar(10)
  status         String            @default("open") @db.VarChar(10)
  tableNo        String?           @db.VarChar(20)
  // الطاولة (من الطاولات المتسجلة) + عدد الأفراد (حجز أونلاين)
  tableId        Int?
  table          RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  partySize      Int?
  channelId      Int?
  channel        SalesChannel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  // رقم الطلب في التطبيق (هنقرستيشن...)
  channelOrderNo String?           @db.VarChar(50)
  driverId       Int?
  driver         RestaurantDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  customerId     Int?
  customerName   String?           @db.VarChar(150)
  phone          String?           @db.VarChar(30)
  address        String?           @db.VarChar(500)
  deliveryFee    Decimal           @default(0) @db.Decimal(18, 4)
  // الخدمة: serviceType percent نسبة | amount مبلغ، والقيمة في servicePercent
  serviceType    String            @default("percent") @db.VarChar(10)
  servicePercent Decimal           @default(0) @db.Decimal(18, 4)
  // الطاولة المفتوحة: سطور السلة لحد ما تتفوتر
  orderLines     Json?
  total          Decimal           @default(0) @db.Decimal(18, 4)
  saleId         Int?              @unique
  sale           Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdById    Int?
  // الطلب الأونلاين: source online + ميعاد الوصول وطريقة الاستلام (store المحل | car السيارة)
  // status pending = جديد لسه ماتقبلش
  source         String            @default("pos") @db.VarChar(10)
  pickupAt       DateTime?
  pickupMode     String?           @db.VarChar(10)
  carInfo        String?           @db.VarChar(100)
  notes          String?           @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, bizDay, dailyNo])
  @@index([source, status])
  @@index([status])
  @@index([channelId])
  @@index([driverId])
  @@index([tableId])
  @@map("restaurant_orders")
}

// طابعات المطعم (لكل فرع): kind cashier الكاشير | kitchen تحضير
// connection: network شبكة (host:port) | windows طابعة ويندوز بالاسم | browser المتصفح
// التحضير: أقسام الطابعة + أصناف خاصة بيها، والباقي على الافتراضية (isDefault)
model RestaurantPrinter {
  id          Int     @id @default(autoincrement())
  branchId    Int
  branch      Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String  @db.VarChar(100)
  kind        String  @default("kitchen") @db.VarChar(10)
  connection  String  @default("network") @db.VarChar(10)
  host        String? @db.VarChar(100)
  port        Int     @default(9100)
  windowsName String? @db.VarChar(150)
  paperSize   String  @default("80mm") @db.VarChar(10)
  copies      Int     @default(1)
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)
  // الأولوية (الأصغر يطبع الأول) + قص الورق + صوت التنبيه
  // fullTicket: الكاشير بيطبع مع الفاتورة تذكرة تحضير كاملة بكل الأصناف
  priority    Int     @default(0)
  autoCut     Boolean @default(true)
  beep        Boolean @default(false)
  fullTicket  Boolean @default(false)
  jobs        PrintJob[]

  categories RestaurantPrinterCategory[]
  products   RestaurantPrinterProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@map("restaurant_printers")
}

model RestaurantPrinterCategory {
  printerId  Int
  printer    RestaurantPrinter @relation(fields: [printerId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([printerId, categoryId])
  @@index([categoryId])
  @@map("restaurant_printer_categories")
}

model RestaurantPrinterProduct {
  printerId Int
  printer   RestaurantPrinter @relation(fields: [printerId], references: [id], onDelete: Cascade)
  productId Int
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([printerId, productId])
  @@index([productId])
  @@map("restaurant_printer_products")
}

// طاولات المطعم (لكل فرع): الاسم/الرقم وعدد الكراسي
model RestaurantTable {
  id        Int     @id @default(autoincrement())
  branchId  Int
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String  @db.VarChar(30)
  seats     Int     @default(4)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  orders RestaurantOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@map("restaurant_tables")
}

// وسيط الطباعة: جهاز ويندوز مربوط بفرع (بكود الفرع printAgentKey)
// winPrinters: طابعات ويندوز المتسطبة على الجهاز (الوسيط بيبعتها)
model PrintAgent {
  id           Int       @id @default(autoincrement())
  branchId     Int
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String    @db.VarChar(100)
  hostName     String?   @db.VarChar(100)
  tokenHash    String    @unique @db.VarChar(64)
  agentVersion String?   @db.VarChar(20)
  winPrinters  Json?
  lastSeenAt   DateTime?
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@map("print_agents")
}

// مهام الطباعة: jobKind print صورة | test تجربة | probe اختبار IP | scan بحث
// jobStatus: queued مستنية | taken اتسحبت | done تمت | failed فشلت
model PrintJob {
  id          Int                @id @default(autoincrement())
  branchId    Int
  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  printerId   Int?
  printer     RestaurantPrinter? @relation(fields: [printerId], references: [id], onDelete: SetNull)
  agentId     Int?
  jobKind     String             @default("print") @db.VarChar(10)
  title       String?            @db.VarChar(150)
  connection  String?            @db.VarChar(10)
  targetHost  String?            @db.VarChar(100)
  targetPort  Int?
  windowsName String?            @db.VarChar(150)
  paperSize   String             @default("80mm") @db.VarChar(10)
  copies      Int                @default(1)
  autoCut     Boolean            @default(true)
  beep        Boolean            @default(false)
  priority    Int                @default(0)
  imageData   String?            @db.LongText
  jobStatus   String             @default("queued") @db.VarChar(10)
  attempts    Int                @default(0)
  errorText   String?            @db.VarChar(500)
  resultData  Json?
  createdAt   DateTime           @default(now())
  takenAt     DateTime?
  doneAt      DateTime?

  @@index([branchId, jobStatus, priority])
  @@index([printerId])
  @@map("print_jobs")
}
